---
import Icon from './Icon.astro';
import { whatsappLink } from '../data/brokers';

interface Props {
	/** claro: tinta sobre papel. oscuro: celeste sobre campo oscuro (como en el hero). */
	tono?: 'claro' | 'oscuro';
}
const { tono = 'claro' } = Astro.props;
---

<div class="flex items-center gap-3">
	<a
		href="/cotizar"
		class:list={['ix-accion', tono === 'claro' ? 'ix-ink' : 'ix-celeste', 'inline-flex h-14 flex-1 items-center justify-between gap-6 px-6 text-[1.25rem] font-bold no-underline sm:min-w-[19rem] sm:flex-none']}
	>
		Cotizá tu seguro
		<Icon name="arrowRight" class="ix-flecha size-6" strokeWidth={2} />
	</a>
	<!-- Botón de solo ícono: puede ser circular (excepción de DESIGN.md) -->
	<a
		href={whatsappLink('Hola, quiero hacer una consulta.')}
		aria-label="Escribinos por WhatsApp"
		class:list={['ix-accion', tono === 'claro' ? 'ix-ink' : 'ix-celeste', 'grid size-14 shrink-0 place-items-center rounded-full no-underline']}
	>
		<Icon name="whatsapp" class="size-6" />
	</a>
</div>
