---
import { aseguradoras } from '../data/brokers';
---

<section class="border-t-2 border-ink" aria-labelledby="aseg-titulo">
	<div class="mx-auto max-w-[84rem] px-4 py-16 sm:px-8 sm:py-20 lg:px-12">
		<h2 id="aseg-titulo" class="text-[clamp(2rem,1.5rem+2vw,3rem)] font-bold">Trabajamos con estas aseguradoras</h2>
		<ul class="mt-10 grid grid-cols-2 border-t-2 border-l border-ink sm:grid-cols-3 lg:grid-cols-5">
			{aseguradoras.map((a) => (
				<li class="flex min-h-24 items-center border-r border-b border-rule px-4 py-5 text-[1.125rem] font-semibold leading-tight [font-stretch:92%] sm:min-h-28 sm:px-6 sm:text-[1.25rem]">
					{a}
				</li>
			))}
		</ul>
	</div>
</section>
