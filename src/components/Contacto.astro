---
import ContactoMapa from './ContactoMapa.astro';
import Icon from './Icon.astro';
import { contacto, whatsappLink } from '../data/brokers';

const info = contacto.emails[0].email;
const instagram = contacto.instagramUsuario.replace(/^@/, '');
---

<section id="contacto" class="relative border-t-2 border-ink" aria-labelledby="contacto-titulo">
	<!-- Mapa a sangre; la hoja va a la derecha, sobre el mar -->
	<ContactoMapa class="contacto-mapa h-80 w-full lg:absolute lg:inset-0 lg:h-auto" />

	<div class="pointer-events-none relative mx-auto max-w-[84rem] px-4 py-12 sm:px-8 lg:flex lg:min-h-[44rem] lg:justify-end lg:px-12 lg:py-16">
		<div class="pointer-events-auto relative isolate bg-sheet p-6 sm:p-8 lg:w-[32rem] lg:self-center lg:border-2 lg:border-ink">
			<h2 id="contacto-titulo" class="field-no border-t-2 border-current pt-3 opacity-75">Encontranos</h2>
			<p class="mt-4 text-[clamp(1.75rem,1.2rem+2vw,2.25rem)] leading-[1.05] font-bold [font-stretch:88%] tracking-[-0.02em]">{contacto.direccion}</p>
			<p class="mt-1 text-[1.125rem] text-ink-2">{contacto.ciudad}</p>
			<div class="mt-4 text-[1.125rem]">
				<span class="font-medium">{contacto.horario}</span>
				<span class="mt-1 flex items-center gap-2 font-mono text-[0.875rem] text-ink-2" data-horario><span class="size-2.5 rounded-full bg-rule" data-horario-dot aria-hidden="true"></span><span data-horario-texto></span></span>
			</div>
			<div class="mt-6 grid grid-cols-3 gap-2">
				<a href={contacto.telefonoHref} class="ix-accion ix-ink flex min-h-24 flex-col items-center justify-center gap-2 px-2 py-3 text-center text-[1.125rem] font-semibold no-underline"><Icon name="phone" class="size-6" />Llamar</a>
				<a href={whatsappLink('Hola, quiero hacer una consulta.')} class="ix-accion ix-seal flex min-h-24 flex-col items-center justify-center gap-2 px-2 py-3 text-center text-[1.125rem] font-semibold no-underline"><Icon name="whatsapp" class="size-6" />WhatsApp</a>
				<a href={contacto.mapa} target="_blank" rel="noopener" class="ix-accion ix-wash flex min-h-24 flex-col items-center justify-center gap-2 border-2 border-ink px-2 py-3 text-center text-[1.125rem] font-semibold no-underline"><Icon name="mapPin" class="size-6" />Cómo llegar</a>
			</div>
			<p class="mt-5 flex flex-col items-start gap-y-2 border-t border-rule pt-4 text-[1rem]">
				<a href={`mailto:${info}`} class="inline-flex items-center gap-2 wrap-anywhere"><Icon name="mail" class="size-5 shrink-0" /><span class="ix-sub">{info}</span></a>
				<a href={contacto.instagram} target="_blank" rel="noopener" class="inline-flex items-center gap-2"><Icon name="instagram" class="size-5 shrink-0" /><span class="ix-sub">{instagram}</span></a>
			</p>
		</div>
	</div>
</section>

<style>
	/* Grano solo sobre el mapa: las dos capas de la trama de la marca, por debajo del pin */
	:global(.contacto-mapa.mapa)::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 5;
		pointer-events: none;
		background-image: var(--grano), var(--grano);
		background-size: 128px 128px, 211px 211px;
		background-position: 0 0, 37px 61px;
	}
</style>

<script>
	// Estado de atención según la hora de Argentina (UTC-3, sin horario de verano).
	const partes = new Intl.DateTimeFormat('en-US', {
		timeZone: 'America/Argentina/Buenos_Aires',
		weekday: 'short',
		hour: 'numeric',
		minute: 'numeric',
		hour12: false,
	}).formatToParts(new Date());
	const get = (t: string) => partes.find((p) => p.type === t)?.value ?? '';
	const dia = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(get('weekday'));
	const minutos = (Number(get('hour')) % 24) * 60 + Number(get('minute'));
	const habil = dia >= 1 && dia <= 5;
	const abierto = habil && minutos >= 9 * 60 && minutos < 15 * 60;

	let texto: string;
	if (abierto) texto = 'Abierto ahora · hasta las 15 hs';
	else if (habil && minutos < 9 * 60) texto = 'Cerrado · abrimos hoy a las 9 hs';
	else if (dia >= 1 && dia <= 4) texto = 'Cerrado · abrimos mañana a las 9 hs';
	else texto = 'Cerrado · abrimos el lunes a las 9 hs';

	document.querySelectorAll<HTMLElement>('[data-horario]').forEach((el) => {
		const t = el.querySelector('[data-horario-texto]');
		const dot = el.querySelector('[data-horario-dot]');
		if (t) t.textContent = texto;
		dot?.classList.replace('bg-rule', abierto ? 'bg-seal' : 'bg-claim');
	});
</script>
