---
import { Image } from 'astro:assets';
import costa from '../assets/img/costa-mar-del-plata.jpg';
import Icon from './Icon.astro';
import { contacto, whatsappLink } from '../data/brokers';
---

<section id="contacto" class="border-t-2 border-ink" aria-labelledby="contacto-titulo">
	<div class="mx-auto grid max-w-[84rem] gap-12 px-4 py-16 sm:px-8 sm:py-20 lg:grid-cols-[minmax(0,6fr)_minmax(0,6fr)] lg:gap-16 lg:px-12 lg:py-24">
		<div class="flex flex-col">
			<h2 id="contacto-titulo" class="text-[clamp(2.25rem,1.6rem+2.6vw,3.75rem)] font-bold">Vení a vernos o escribinos</h2>

			<dl class="mt-10 border-t-2 border-ink text-[1.125rem]">
				<div class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3 border-b border-rule py-4">
					<dt class="pt-0.5"><Icon name="mapPin" class="size-5" /><span class="sr-only">Dirección</span></dt>
					<dd>
						<span class="font-semibold">{contacto.direccion}</span>, {contacto.ciudad}
						<a href={contacto.mapa} target="_blank" rel="noopener" class="mt-1 block w-fit font-medium">Cómo llegar</a>
					</dd>
				</div>
				<div class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3 border-b border-rule py-4">
					<dt class="pt-0.5"><Icon name="clock" class="size-5" /><span class="sr-only">Horario</span></dt>
					<dd>
						{contacto.horario}
						<span class="mt-1 flex items-center gap-2 font-mono text-[0.9375rem] text-ink-2" data-horario>
							<span class="size-2.5 rounded-full bg-rule" data-horario-dot aria-hidden="true"></span>
							<span data-horario-texto></span>
						</span>
					</dd>
				</div>
				<div class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3 border-b border-rule py-4">
					<dt class="pt-0.5"><Icon name="phone" class="size-5" /><span class="sr-only">Teléfono</span></dt>
					<dd><a href={contacto.telefonoHref} class="font-semibold no-underline hover:underline">{contacto.telefono}</a></dd>
				</div>
				<div class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3 border-b border-rule py-4">
					<dt class="pt-0.5"><Icon name="mail" class="size-5" /><span class="sr-only">Emails por área</span></dt>
					<dd>
						<a href={`mailto:${contacto.emails[0].email}`} class="[overflow-wrap:anywhere] hover:no-underline">{contacto.emails[0].email}</a>
						<details class="group/mails mt-1">
							<summary class="w-fit cursor-pointer list-none font-medium text-ink-2 underline decoration-1 underline-offset-[0.22em] [&::-webkit-details-marker]:hidden hover:text-ink">
								<span class="group-open/mails:hidden">Ver mails por área</span><span class="hidden group-open/mails:inline">Ocultar mails por área</span>
							</summary>
							<ul class="mt-2 flex flex-col gap-1.5">
								{contacto.emails.slice(1).map((e) => (
									<li class="flex flex-col sm:flex-row sm:gap-3">
										<span class="text-ink-2 sm:w-32 sm:shrink-0">{e.area}</span>
										<a href={`mailto:${e.email}`} class="[overflow-wrap:anywhere] hover:no-underline">{e.email}</a>
									</li>
								))}
							</ul>
						</details>
					</dd>
				</div>
				<div class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3 border-b border-rule py-4">
					<dt class="pt-0.5"><Icon name="instagram" class="size-5" /><span class="sr-only">Instagram</span></dt>
					<dd><a href={contacto.instagram} target="_blank" rel="noopener" class="hover:no-underline">{contacto.instagramUsuario}</a></dd>
				</div>
			</dl>

			<a
				href={whatsappLink('Hola, quiero hacer una consulta.')}
				class="group mt-10 inline-flex items-center justify-between gap-4 bg-seal px-6 py-4.5 text-[1.25rem] font-semibold text-paper no-underline transition-colors duration-200 hover:bg-seal-deep sm:w-fit sm:min-w-[24rem]"
			>
				<span class="inline-flex items-center gap-3"><Icon name="whatsapp" class="size-6" />Escribinos por WhatsApp</span>
				<Icon name="arrowRight" class="size-6 transition-transform duration-300 ease-out-expo group-hover:translate-x-1" strokeWidth={2} />
			</a>
		</div>

		<figure class="self-start lg:sticky lg:top-8">
			<div class="border-2 border-ink bg-sheet p-2.5 sm:p-3">
				<Image
					src={costa}
					alt="Playa de Mar del Plata en verano, con sombrillas de colores frente al mar"
					widths={[480, 800, 1200]}
					sizes="(min-width: 1024px) 40rem, 100vw"
					class="aspect-[4/5] w-full object-cover object-[38%_50%] sm:aspect-[4/3] lg:aspect-[4/5]"
				/>
			</div>
			<figcaption class="mt-3 flex justify-between gap-4 font-mono text-[0.875rem] text-ink-2">
				<span>Mar del Plata, Buenos Aires</span>
				<span>Foto provisoria · Micaela Sosa / Unsplash</span>
			</figcaption>
		</figure>
	</div>
</section>

<script>
	// Estado de atención según la hora de Argentina (UTC-3, sin horario de verano).
	const partes = new Intl.DateTimeFormat('en-US', {
		timeZone: 'America/Argentina/Buenos_Aires',
		weekday: 'short',
		hour: 'numeric',
		minute: 'numeric',
		hour12: false,
	}).formatToParts(new Date());
	const get = (t: string) => partes.find((p) => p.type === t)?.value ?? '';
	const dia = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(get('weekday'));
	const minutos = (Number(get('hour')) % 24) * 60 + Number(get('minute'));
	const habil = dia >= 1 && dia <= 5;
	const abierto = habil && minutos >= 9 * 60 && minutos < 15 * 60;

	let texto: string;
	if (abierto) texto = 'Abierto ahora · hasta las 15 hs';
	else if (habil && minutos < 9 * 60) texto = 'Cerrado · abrimos hoy a las 9 hs';
	else if (dia >= 1 && dia <= 4) texto = 'Cerrado · abrimos mañana a las 9 hs';
	else texto = 'Cerrado · abrimos el lunes a las 9 hs';

	document.querySelectorAll<HTMLElement>('[data-horario]').forEach((el) => {
		const t = el.querySelector('[data-horario-texto]');
		const dot = el.querySelector('[data-horario-dot]');
		if (t) t.textContent = texto;
		dot?.classList.replace('bg-rule', abierto ? 'bg-seal' : 'bg-claim');
	});
</script>
