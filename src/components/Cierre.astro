---
import CierreCtas from './CierreCtas.astro';

const titulo = 'Contanos qué querés cuidar.';
const bajada = 'Del resto nos ocupamos nosotros.';
---

<!-- Cierre: solo tipografía. Campo de tinta con grano (el corte contra el papel de Equipo).
     En celular los botones se omiten: la barra fija inferior ya ofrece Cotizá y WhatsApp. -->
<section class="con-grano bg-ink text-paper" aria-labelledby="cierre-titulo">
	<div data-reveal class="mx-auto max-w-[84rem] px-4 py-20 sm:px-8 sm:py-28 lg:px-12 lg:py-32">
		<h2 id="cierre-titulo" class="max-w-[14ch] text-balance text-[clamp(3.05rem,1.6rem+5.6vw,6.75rem)] leading-[0.95] font-bold [font-stretch:84%]">{titulo}</h2>
		<div class="mt-10 border-t border-paper/40 pt-8 lg:mt-14 lg:grid lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:gap-16">
			<p class="max-w-[34ch] text-[1.375rem] leading-[1.45] text-on-dark sm:text-[1.5rem]">{bajada}</p>
			<div class="mt-8 hidden md:block lg:mt-0"><CierreCtas tono="oscuro" showWhatsapp={false} /></div>
		</div>
	</div>
</section>
