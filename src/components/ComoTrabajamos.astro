---
// Cláusulas: el texto institucional real ("Qué hacemos" / "Aseguradoras"), resumido como el recorrido del servicio.
const clausulas = [
	{ titulo: 'Elegimos la aseguradora', texto: 'Compañías sólidas y con vocación de servicio.' },
	{ titulo: 'Definimos la cobertura', texto: 'La que se adapta a lo que necesitás asegurar.' },
	{ titulo: 'Buscamos el precio adecuado', texto: 'Comparamos para que pagues lo justo.' },
	{ titulo: 'Te asistimos en el siniestro', texto: 'Te guiamos en cada paso de la denuncia.' },
];
---

<section id="como-trabajamos" class="bg-logo text-paper" aria-labelledby="como-titulo">
	<div class="mx-auto grid max-w-[84rem] gap-12 px-4 py-16 sm:px-8 sm:py-20 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20 lg:px-12 lg:py-24">
		<div>
			<h2 id="como-titulo" class="text-[clamp(2.25rem,1.6rem+2.6vw,3.75rem)] font-bold">Qué hacemos por vos</h2>
			<p class="mt-6 max-w-[30ch] text-[1.25rem] text-on-dark">
				Más de 35 años asesorando a personas y empresas de Mar del Plata.
			</p>
		</div>

		<ol class="border-t-2 border-paper">
			{clausulas.map((c, i) => (
				<li class="grid grid-cols-[3.75rem_minmax(0,1fr)] items-baseline gap-x-4 border-b border-paper/30 py-5 sm:grid-cols-[4.5rem_minmax(0,1fr)] sm:py-6">
					<span class="font-mono text-[0.875rem] font-medium whitespace-nowrap text-seal-on-dark">Art. {i + 1}</span>
					<div>
						<h3 class="text-[1.5rem] font-bold sm:text-[1.75rem]">{c.titulo}</h3>
						<p class="mt-1 text-[1.125rem] text-on-dark sm:text-[1.125rem]">{c.texto}</p>
					</div>
				</li>
			))}
		</ol>
	</div>
</section>
