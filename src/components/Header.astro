---
import { Image } from 'astro:assets';
import logo from '../assets/img/logo-brokers.jpg';
import Icon from './Icon.astro';
import { whatsappLink } from '../data/brokers';

interface Props {
	/** La página arranca con un hero fotográfico: la barra empieza transparente sobre él. */
	sobreHero?: boolean;
}
const { sobreHero = false } = Astro.props;

const nav = [
	{ href: '/#coberturas', label: 'Seguros' },
	{ href: '/#siniestros', label: 'Siniestros', siniestro: true },
	{ href: '/#contacto', label: 'Contacto' },
];
---

<header data-header data-sobre-hero={sobreHero || undefined} class="site-header fixed inset-x-0 top-0 z-50">
	<div class="header-bar">
		<div class="mx-auto flex h-[4.5rem] max-w-[84rem] items-center gap-8 px-4 sm:px-8 lg:px-12">
			<a href="/" class="flex shrink-0 items-center gap-3 no-underline" aria-label="Brokers Asociados, inicio">
				<Image src={logo} alt="" width={44} height={44} densities={[1, 2]} class="size-11 rounded-full" loading="eager" />
				<span class="text-[1.25rem] font-bold tracking-[-0.01em] [font-stretch:90%]">Brokers Asociados</span>
			</a>

			<nav aria-label="Principal" class="ml-auto hidden md:block">
				<ul class="flex items-center gap-8 text-[1.0625rem] font-medium">
					{nav.map((item) => (
						<li>
							<a href={item.href} class="nav-link inline-flex items-center gap-2 py-1 no-underline">
								{item.siniestro && <span class="size-2 rounded-full bg-claim" aria-hidden="true"></span>}
								{item.label}
							</a>
						</li>
					))}
				</ul>
			</nav>

			<a href="/cotizar" class="header-cta group hidden items-center gap-2 px-4 py-2.5 text-[1.0625rem] font-semibold no-underline md:inline-flex">
				Cotizá
				<Icon name="arrowRight" class="size-[1.125rem] transition-transform duration-300 ease-out-expo group-hover:translate-x-0.5" strokeWidth={2.25} />
			</a>

			<button
				type="button"
				class="menu-toggle ml-auto inline-flex min-h-11 items-center gap-3 pl-2 text-[1.0625rem] font-semibold md:hidden"
				aria-expanded="false"
				aria-controls="menu-movil"
				data-menu-toggle
			>
				<span data-menu-label>Menú</span>
				<span class="relative grid size-6 place-items-center" aria-hidden="true">
					<span class="menu-linea linea-a"></span>
					<span class="menu-linea linea-b"></span>
				</span>
			</button>
		</div>
	</div>

	<!-- Menú del celular -->
	<div id="menu-movil" class="menu-movil grid md:hidden" data-menu inert>
		<div class="overflow-hidden">
			<nav aria-label="Menú" class="superficie-papel border-b border-rule-soft px-4 pt-2 pb-6 sm:px-8">
				<ul class="flex flex-col">
					{nav.map((item) => (
						<li class="border-b border-rule-soft">
							<a href={item.href} class="flex items-center justify-between py-4 text-[1.5rem] font-semibold no-underline" data-menu-link>
								<span class="inline-flex items-center gap-3">
									{item.siniestro && <span class="size-2.5 rounded-full bg-claim" aria-hidden="true"></span>}
									{item.label}
								</span>
								<Icon name="arrowRight" class="size-5" strokeWidth={2} />
							</a>
						</li>
					))}
				</ul>
				<div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
					<a href="/cotizar" class="inline-flex items-center justify-between bg-ink px-5 py-4 text-[1.125rem] font-semibold text-paper no-underline" data-menu-link>
						Cotizá tu seguro <Icon name="arrowRight" class="size-5" strokeWidth={2} />
					</a>
					<a href={whatsappLink('Hola, quiero hacer una consulta.')} class="inline-flex items-center justify-center gap-2.5 bg-seal px-5 py-4 text-[1.125rem] font-semibold text-paper no-underline">
						<Icon name="whatsapp" class="size-5" />WhatsApp
					</a>
				</div>
			</nav>
		</div>
	</div>
</header>

<style>
	.site-header {
		transition: transform 0.45s var(--ease-out-expo);
		animation: header-entra 0.7s var(--ease-out-expo) both;
	}
	@keyframes header-entra {
		from { transform: translateY(-100%); }
		to { transform: translateY(0); }
	}
	.site-header[data-oculto]:not(:focus-within) {
		transform: translateY(-100%);
	}

	.header-bar {
		background: var(--grano) 0 0 / 200px 200px, var(--color-paper);
		border-bottom: 1px solid var(--color-rule-soft);
		color: var(--color-ink);
		transition: background-color 0.3s ease-out, color 0.3s ease-out, border-color 0.3s ease-out;
	}
	.header-cta {
		background-color: var(--color-ink);
		color: var(--color-paper);
		transition: background-color 0.3s ease-out, color 0.3s ease-out;
	}
	.header-cta:hover {
		background-color: var(--color-ink-deep);
	}

	/* Sobre el hero: transparente hasta que se scrollea o se abre el menú */
	.site-header[data-sobre-hero]:not([data-solido]):not([data-abierto]) .header-bar {
		background: transparent;
		border-color: transparent;
		color: var(--color-paper);
	}
	.site-header[data-sobre-hero]:not([data-solido]):not([data-abierto]) .header-cta {
		background-color: var(--color-paper);
		color: var(--color-ink);
	}

	/* Subrayado que se dibuja de izquierda a derecha */
	.nav-link {
		position: relative;
	}
	.nav-link::after {
		content: '';
		position: absolute;
		inset-inline: 0;
		bottom: -2px;
		height: 2px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 0.35s var(--ease-out-expo);
	}
	.nav-link:hover::after,
	.nav-link:focus-visible::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	/* Botón de menú: dos líneas que se cruzan */
	.menu-linea {
		position: absolute;
		width: 1.5rem;
		height: 2px;
		background: currentColor;
		transition: transform 0.35s var(--ease-out-expo);
	}
	.linea-a { transform: translateY(-4px); }
	.linea-b { transform: translateY(4px); }
	[data-abierto] .linea-a { transform: rotate(45deg); }
	[data-abierto] .linea-b { transform: rotate(-45deg); }

	/* El menú se despliega animando la altura */
	.menu-movil {
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.45s var(--ease-out-expo);
	}
	[data-abierto] .menu-movil {
		grid-template-rows: 1fr;
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.menu-movil,
		.menu-linea,
		.nav-link::after { animation: none; transition: none; }
	}
</style>

<script>
	const header = document.querySelector<HTMLElement>('[data-header]')!;
	const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
	const menu = header.querySelector<HTMLElement>('[data-menu]')!;
	const sobreHero = header.hasAttribute('data-sobre-hero');
	const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');
	let ultimoY = window.scrollY;
	let pendiente = false;

	function alScrollear() {
		const y = window.scrollY;
		header.toggleAttribute('data-solido', !sobreHero || y > 24);
		const bajando = y > ultimoY + 2;
		const subiendo = y < ultimoY - 2;
		if (bajando && y > 160 && !header.hasAttribute('data-abierto') && !sinMovimiento.matches) header.setAttribute('data-oculto', '');
		if (subiendo || y <= 160) header.removeAttribute('data-oculto');
		ultimoY = y;
		pendiente = false;
	}
	alScrollear();
	window.addEventListener(
		'scroll',
		() => {
			if (!pendiente) {
				pendiente = true;
				requestAnimationFrame(alScrollear);
			}
		},
		{ passive: true },
	);

	header.addEventListener('focusin', () => header.removeAttribute('data-oculto'));

	function abrir(abierto: boolean) {
		header.toggleAttribute('data-abierto', abierto);
		header.querySelector('[data-menu-label]')!.textContent = abierto ? 'Cerrar' : 'Menú';
		toggle.setAttribute('aria-expanded', String(abierto));
		menu.inert = !abierto;
	}
	toggle.addEventListener('click', () => abrir(!header.hasAttribute('data-abierto')));
	menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => abrir(false)));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && header.hasAttribute('data-abierto')) {
			abrir(false);
			toggle.focus();
		}
	});
</script>
