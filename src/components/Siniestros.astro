---
import Icon from './Icon.astro';
import { siniestros } from '../data/brokers';

const slug = (s: string) =>
	s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/\s+/g, '-');

const iconos: Record<string, Parameters<typeof Icon>[0]['name']> = {
	Choque: 'carFront',
	Cristales: 'parabrisas',
	Cerraduras: 'lockKeyhole',
	'Robo de ruedas': 'llanta',
	'Robo del vehículo': 'siren',
	'Robo o daño del celular': 'smartphone',
	'Otros daños en el hogar': 'house',
	'Daños en el comercio': 'store',
	'Daños en el consorcio': 'building2',
};

// Disposición de cada grupo, de mayor a menor importancia
const disposicion: Record<string, { grupo: string; lista: string; ultimoAncho?: boolean }> = {
	Auto: { grupo: 'col-span-2 lg:col-span-6', lista: 'grid-cols-2 lg:grid-cols-3', ultimoAncho: true },
	Hogar: { grupo: 'col-span-2 lg:col-span-3', lista: 'grid-cols-2' },
	'Comercio y consorcio': { grupo: 'col-span-2 lg:col-span-3', lista: 'grid-cols-2' },
};
---

<section id="siniestros" class="sin bg-claim-field relative text-paper" aria-labelledby="sin-titulo">
	<div class="mx-auto grid max-w-[84rem] gap-12 px-4 py-16 sm:px-8 sm:py-20 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16 lg:px-12 lg:py-24">
		<div class="flex flex-col">
			<h2 id="sin-titulo" class="text-[clamp(2.5rem,1.7rem+3.2vw,4.5rem)] font-bold [font-stretch:84%]">¿Tuviste un siniestro?</h2>
			<p class="mt-5 max-w-[32ch] text-[1.25rem] text-claim-soft">Respirá. Elegí qué te pasó y te guiamos con la denuncia.</p>

			<a
				href="/siniestros/denuncia"
				class="group mt-10 inline-flex items-center justify-between gap-6 self-start bg-paper px-6 py-5 text-[1.375rem] font-bold text-claim-deep no-underline transition-colors duration-200 hover:bg-claim-soft lg:min-w-[22rem]"
			>
				Denunciar un siniestro
				<Icon name="arrowRight" class="size-7 transition-transform duration-300 ease-out-expo group-hover:translate-x-1" strokeWidth={2.25} />
			</a>
		</div>

		<div class="flex flex-col">
			<h3 class="sr-only">¿Qué te pasó?</h3>
			<div class="grid grid-cols-2 gap-x-3 gap-y-8 lg:grid-cols-6 lg:gap-x-3">
				{siniestros.map((g) => {
					const d = disposicion[g.grupo];
					return (
						<div class:list={['flex flex-col', d.grupo]}>
							<h4 class="border-t-2 border-paper pt-2.5 text-[1.125rem] font-semibold">{g.grupo}</h4>
							<ul class:list={['mt-3 grid flex-1 auto-rows-fr gap-2.5 lg:gap-3', d.lista]}>
								{g.tipos.map((tipo, i) => (
									<li class:list={[d.ultimoAncho && i === g.tipos.length - 1 && 'col-span-2']}>
										<a
											href={`/siniestros/denuncia?tipo=${slug(`${g.grupo} ${tipo}`)}`}
											class="tile-sin group relative flex h-full min-h-32 flex-col justify-between gap-4 overflow-hidden bg-sheet p-4 text-claim-deep no-underline lg:min-h-30"
										>
											<Icon name={iconos[tipo]} class="icono-sin relative z-10 size-9 text-claim" strokeWidth={1.6} />
											<span class="relative z-10 flex items-end justify-between gap-2">
												<span class="text-[1.125rem] font-semibold leading-tight text-ink sm:text-[1.1875rem]">{tipo}</span>
												<Icon name="arrowRight" class="flecha-sin size-5 shrink-0 text-claim" strokeWidth={2} />
											</span>
										</a>
									</li>
								))}
							</ul>
						</div>
					);
				})}
			</div>
		</div>
	</div>

</section>

<style>
	/* Mosaicos: el relleno suave barre desde abajo; ícono sube, flecha avanza, el click presiona */
	.tile-sin {
		transition: transform 0.35s var(--ease-out-expo);
	}
	.tile-sin::before {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--color-claim-soft);
		transform: translateY(101%);
		transition: transform 0.5s var(--ease-out-expo);
	}
	.icono-sin,
	.flecha-sin {
		transition: transform 0.45s var(--ease-out-expo);
	}
	.tile-sin:hover::before,
	.tile-sin:focus-visible::before {
		transform: translateY(0);
	}
	.tile-sin:hover .icono-sin,
	.tile-sin:focus-visible .icono-sin {
		transform: translateY(-4px);
	}
	.tile-sin:hover .flecha-sin,
	.tile-sin:focus-visible .flecha-sin {
		transform: translateX(5px);
	}
	.tile-sin:active {
		transform: scale(0.98);
		transition-duration: 0.12s;
	}
	@media (prefers-reduced-motion: reduce) {
		.tile-sin,
		.tile-sin::before,
		.icono-sin,
		.flecha-sin { transition: none; }
		.tile-sin:hover .icono-sin,
		.tile-sin:focus-visible .icono-sin,
		.tile-sin:hover .flecha-sin,
		.tile-sin:focus-visible .flecha-sin,
		.tile-sin:active { transform: none; }
		.tile-sin::before { transform: none; opacity: 0; }
		.tile-sin:hover::before,
		.tile-sin:focus-visible::before { opacity: 1; }
	}
</style>
