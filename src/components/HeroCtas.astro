---
import Icon from './Icon.astro';
import { whatsappLink } from '../data/brokers';

interface Props {
	/** oscuro: celeste sobre foto o campo oscuro. claro: tinta sobre papel. */
	tono?: 'oscuro' | 'claro';
	centrado?: boolean;
}
const { tono = 'oscuro', centrado = false } = Astro.props;
const boton = tono === 'oscuro' ? 'ix-celeste' : 'ix-ink';
---

<div class:list={['cta-grupo flex flex-col', centrado ? 'items-center' : 'items-start']}>
	<div class:list={['flex w-full items-center gap-3', centrado && 'justify-center']}>
		<a
			href="/cotizar"
			class:list={['ix-accion', boton, 'inline-flex h-14 flex-1 items-center justify-between gap-4 px-5 whitespace-nowrap sm:gap-6 sm:px-6 text-[1.25rem] font-bold no-underline sm:min-w-[19rem] sm:flex-none']}
		>
			Cotizá tu seguro
			<Icon name="arrowRight" class="ix-flecha size-6" strokeWidth={2} />
		</a>
		<!-- Botón de solo ícono: puede ser circular (excepción de DESIGN.md) -->
		<a
			href={whatsappLink('Hola, quiero cotizar un seguro.')}
			aria-label="Escribinos por WhatsApp"
			class:list={['ix-accion', boton, 'grid size-14 shrink-0 place-items-center rounded-full no-underline']}
		>
			<Icon name="whatsapp" class="size-6" />
		</a>
	</div>

	<a href="#siniestros" class:list={['mt-7 inline-flex min-h-11 items-center gap-3 text-[1.125rem] font-medium no-underline', tono === 'oscuro' ? 'text-paper' : 'text-ink']}>
		<span class="rec" aria-hidden="true"></span>
		<span class="ix-sub pb-0.5">¿Tuviste un siniestro? Te ayudamos</span>
	</a>
</div>
