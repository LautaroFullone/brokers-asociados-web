---
import Icon from './Icon.astro';
import { whatsappLink } from '../data/brokers';
---

<div class="cta-grupo">
	<div class="flex items-center gap-3">
		<a
			href="/cotizar"
			class="ix-accion ix-celeste inline-flex h-14 flex-1 items-center justify-between gap-6 px-6 text-[1.25rem] font-bold no-underline sm:min-w-[19rem] sm:flex-none"
		>
			Cotizá tu seguro
			<Icon name="arrowRight" class="ix-flecha size-6" strokeWidth={2} />
		</a>
		<!-- Botón de solo ícono: puede ser circular (excepción de DESIGN.md) -->
		<a
			href={whatsappLink('Hola, quiero cotizar un seguro.')}
			aria-label="Escribinos por WhatsApp"
			class="ix-accion ix-celeste grid size-14 shrink-0 place-items-center rounded-full no-underline"
		>
			<Icon name="whatsapp" class="size-6" />
		</a>
	</div>

	<a href="#siniestros" class="mt-7 inline-flex items-center gap-2.5 text-[1.125rem] font-medium text-paper no-underline">
		<span class="size-2.5 rounded-full bg-claim ring-2 ring-paper/80" aria-hidden="true"></span>
		<span class="ix-sub pb-0.5">¿Tuviste un siniestro? Te ayudamos</span>
	</a>
</div>
