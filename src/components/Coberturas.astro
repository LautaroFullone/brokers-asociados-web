---
import Icon from './Icon.astro';
import { productosPersonas, productosEmpresas } from '../data/brokers';

const paneles = [
	{ id: 'personas', titulo: 'Para vos', productos: productosPersonas },
	{ id: 'empresas', titulo: 'Para tu empresa', productos: productosEmpresas },
];

const enlace = (p: { rama: string; nombre: string }) => `/cotizar?rama=${p.rama}&producto=${encodeURIComponent(p.nombre)}`;
---

<section id="coberturas" class="border-t-2 border-ink" aria-labelledby="coberturas-titulo" data-coberturas>
	<div class="mx-auto max-w-[84rem] px-4 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
		<div>
			<div>
				<h2 id="coberturas-titulo" class="text-[clamp(2.25rem,1.6rem+2.6vw,3.75rem)] font-bold">Qué podemos asegurarte</h2>
				<p class="mt-5 max-w-[40ch] text-[1.25rem] text-ink-2">Para vos, tu familia y tu empresa. Elegí qué querés asegurar y te cotizamos.</p>
			</div>

		</div>

		<div class="mt-6 lg:mt-8">
			<!-- Selector pegado a la grilla: lo muestra el script; sin JS se ven los dos grupos uno debajo del otro -->
			<div class="tabs-fila" data-tabs-fila>
				<div role="tablist" aria-label="Tipo de seguro" class="selector" data-tablist>
										{paneles.map((pn, i) => (
						<button
							type="button"
							role="tab"
							id={`tab-${pn.id}`}
							aria-controls={`panel-${pn.id}`}
							aria-selected={i === 0 ? 'true' : 'false'}
							tabindex={i === 0 ? 0 : -1}
							class="tab ix-control cursor-pointer"
						>
							{pn.titulo}
							<span class="tab-flecha" aria-hidden="true"><Icon name="arrowRight" class="size-4" strokeWidth={2.25} /></span>
						</button>
					))}
				</div>
			</div>

			{paneles.map((pn) => (
				<div id={`panel-${pn.id}`} role="tabpanel" aria-labelledby={`tab-${pn.id}`} class="panel mt-0 mb-14 last:mb-0 focus:outline-none" tabindex="-1" data-panel>
					<h3 class="panel-titulo mb-5 border-b-2 border-ink pb-3 text-[1.75rem] font-bold">{pn.titulo}</h3>
					<ul class="mosaicos grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
						{pn.productos.map((p, i) => {
							const ultimoAncho = pn.id === 'empresas' && i === pn.productos.length - 1;
							return (
								<li
									style={`--i:${i}`}
									class:list={[
										'mosaico',
										p.grande && 'sm:col-span-2 lg:row-span-2',
										ultimoAncho && 'sm:col-span-2 lg:col-span-4',
									]}
								>
									<a
										href={enlace(p)}
										class:list={[
											'tile ix-tarjeta flex h-full flex-col justify-between gap-6 border-[1.5px] no-underline',
											p.grande ? 'tile-grande [--barrido:var(--color-ink-deep)] bg-ink p-6 text-paper sm:p-8 border-ink' : '[--barrido:var(--color-wash)] bg-sheet p-5 text-ink border-rule-soft hover:border-ink focus-visible:border-ink',
											!p.grande && !ultimoAncho && 'min-h-44 lg:min-h-48',
											ultimoAncho && 'min-h-32 lg:flex-row lg:items-center lg:gap-8',
										]}
									>
										<Icon name={p.icono as any} class={p.grande ? 'ix-icono size-14 sm:size-16' : 'ix-icono size-9'} strokeWidth={p.grande ? 1.4 : 1.6} />
										<span class:list={['flex flex-col', ultimoAncho && 'lg:flex-1']}>
											<span class:list={['font-bold leading-tight [font-stretch:90%]', p.grande ? 'text-[1.875rem] sm:text-[2.25rem]' : 'text-[1.25rem] sm:text-[1.375rem]']}>{p.nombre}</span>
											<span class:list={['mt-2 leading-[1.4]', p.grande ? 'max-w-[34ch] text-[1.125rem] text-on-dark' : 'text-[1rem] text-ink-2']}>{p.resumen}</span>
											{p.nota && <span class="mt-2 font-mono text-[0.875rem] text-seal-on-dark">{p.nota}</span>}
										</span>
										<span class:list={['inline-flex items-center gap-2 font-semibold', p.grande ? 'text-[1.25rem]' : 'text-[1.125rem] text-ink']}>
											Cotizar
											<Icon name="arrowRight" class="ix-flecha size-5" strokeWidth={2} />
										</span>
									</a>
								</li>
							);
						})}
					</ul>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.selector { display: none; }
	:global([data-js]) .selector { display: flex; }

	/* Pestañas con subrayado, a la derecha y pegadas a la grilla */
	.tabs-fila {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		gap: 0.5rem 2rem;
		margin-bottom: 1.25rem;
		border-bottom: 1px solid var(--color-rule);
	}
	.selector { order: 2; gap: 2rem; margin-bottom: -1px; width: 100%; }
	.tab {
		position: relative;
		z-index: 1;
		display: inline-flex;
		flex: 1;
		align-items: center;
		justify-content: center;
		min-height: 3.25rem;
		font-size: 1.125rem;
		font-weight: 600;
		white-space: nowrap;
		color: var(--color-ink-2);
		border-bottom: 4px solid transparent;
		transition: color 0.25s var(--ease-out-expo), border-color 0.25s var(--ease-out-expo);
	}
	.tab:hover { color: var(--color-ink); }
	.tab[aria-selected='true'] { color: var(--color-ink); border-bottom-color: var(--color-ink); }
	@media (min-width: 640px) {
		.selector { width: auto; }
		.tab { flex: none; font-size: 1.125rem; }
	}

	/* Aviso: la pestaña no elegida invita a tocarla.
	   Al entrar la sección en pantalla dibuja su subrayado tres veces (< 5 s, sin control de pausa necesario)
	   y después queda con una línea fija y una flecha, hasta el primer cambio. */
	.tab { gap: 0.5rem; }
	.tab::after {
		content: '';
		position: absolute;
		inset: auto 0 -4px 0;
		height: 4px;
		background: var(--color-rule);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.35s var(--ease-out-expo);
	}
	.tab-flecha { display: none; transition: transform 0.3s var(--ease-out-expo); }
	.tab[aria-selected='false']:hover::after { transform: scaleX(1); }
	:global([data-js]) [data-coberturas]:not([data-cambiado]) .tab[aria-selected='false']::after { transform: scaleX(1); height: 2px; bottom: -3px; }
	:global([data-js]) [data-coberturas]:not([data-cambiado]) .tab[aria-selected='false'] .tab-flecha { display: block; }
	.tab:hover .tab-flecha { transform: translateX(3px); }
	:global([data-js]) [data-coberturas]:not([data-cambiado]) .tab[aria-selected='false']:hover::after { height: 4px; bottom: -4px; }
	[data-coberturas][data-visto]:not([data-cambiado]) .tab[aria-selected='false']::after {
		animation: aviso 1.6s var(--ease-out-expo) 0.3s 3 backwards;
	}
	[data-coberturas][data-visto]:not([data-cambiado]) .tab[aria-selected='false'] .tab-flecha {
		animation: aviso-flecha 1.6s var(--ease-out-expo) 0.3s 3 backwards;
	}
	@keyframes aviso {
		0% { transform: scaleX(0); height: 4px; }
		45% { transform: scaleX(1); height: 4px; }
		75% { transform: scaleX(1); height: 4px; }
		100% { transform: scaleX(1); height: 2px; }
	}
	@keyframes aviso-flecha {
		0%, 100% { transform: translateX(0); }
		45% { transform: translateX(4px); }
	}

	:global([data-js]) .panel-titulo { display: none; }
	:global([data-js]) .panel { margin-bottom: 0; }
	:global([data-js]) .panel[hidden] { display: none; }
	:global([data-js]) .panel:not([hidden]) .mosaico {
		animation: mosaico-entra 0.55s var(--ease-out-expo) both;
		animation-delay: calc(var(--i) * 55ms);
	}
	@keyframes mosaico-entra {
		from { opacity: 0; transform: translateY(0.75rem); }
		to { opacity: 1; transform: translateY(0); }
	}
	@media (prefers-reduced-motion: reduce) {
		.mosaico { animation: none !important; }
		.tab, .tab::after, .tab-flecha { transition: none; animation: none !important; }
	}

</style>

<script>
	const raiz = document.querySelector<HTMLElement>('[data-coberturas]')!;
	const lista = raiz.querySelector<HTMLElement>('[data-tablist]')!;
	const tabs = [...raiz.querySelectorAll<HTMLButtonElement>('[role=tab]')];
	const paneles = [...raiz.querySelectorAll<HTMLElement>('[data-panel]')];

	function elegir(i: number, enfocar = false) {
		tabs.forEach((t, j) => {
			t.setAttribute('aria-selected', String(i === j));
			t.tabIndex = i === j ? 0 : -1;
		});
		paneles.forEach((p, j) => (p.hidden = i !== j));
		if (enfocar) tabs[i].focus();
	}

	document.documentElement.setAttribute('data-js', '');
	elegir(0);

	tabs.forEach((t, i) => {
		t.addEventListener('click', () => {
			raiz.setAttribute('data-cambiado', '');
			elegir(i);
		});
		t.addEventListener('keydown', (e) => {
			const n = tabs.length;
			const destino = { ArrowRight: (i + 1) % n, ArrowLeft: (i - 1 + n) % n, Home: 0, End: n - 1 }[e.key as string];
			if (destino === undefined) return;
			e.preventDefault();
			raiz.setAttribute('data-cambiado', '');
			elegir(destino, true);
		});
	});

	// Aviso: cada vez que la sección entra en pantalla (hasta el primer cambio) la otra pestaña se anima de nuevo
	new IntersectionObserver(
		(entradas) => {
			for (const e of entradas) raiz.toggleAttribute('data-visto', e.isIntersecting);
		},
		{ threshold: 0.35 },
	).observe(lista);
</script>
