---
import Icon from './Icon.astro';
import { productosPersonas, productosEmpresas } from '../data/brokers';

const columnas = [
	{ id: 'personas', titulo: 'Para vos', productos: productosPersonas },
	{ id: 'empresas', titulo: 'Para tu empresa', productos: productosEmpresas },
];
---

<section id="coberturas" class="border-t-2 border-ink" aria-labelledby="coberturas-titulo">
	<div class="mx-auto max-w-[84rem] px-4 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
		<h2 id="coberturas-titulo" class="text-[clamp(2.25rem,1.6rem+2.6vw,3.75rem)] font-bold">Qué podemos asegurarte</h2>

		<div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-2 lg:gap-16">
			{columnas.map((col) => (
				<div>
					<h3 class="border-b-2 border-ink pb-3 text-[1.75rem] font-bold sm:text-[2rem]">{col.titulo}</h3>
					<ul>
						{col.productos.map((p) => (
							<li class="border-b border-rule">
								<details class="group/item">
									<summary class="flex min-h-15 cursor-pointer list-none items-center justify-between gap-6 py-3.5 text-[1.25rem] font-semibold [&::-webkit-details-marker]:hidden hover:text-link sm:text-[1.375rem]">
										{p.nombre}
										<span class="grid size-8 shrink-0 place-items-center border-[1.5px] border-ink transition-colors duration-200 group-open/item:bg-ink group-open/item:text-paper" aria-hidden="true">
											<svg class="size-4 transition-transform duration-300 ease-out-expo group-open/item:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25"><path d="M12 5v14M5 12h14" /></svg>
										</span>
									</summary>
									<div class="flex flex-col gap-3 pb-5 sm:flex-row sm:items-end sm:justify-between sm:gap-8">
										<p class="max-w-[52ch] text-[1rem] leading-[1.5] text-ink-2 sm:text-[1.0625rem]">
											{p.coberturas}
											{p.nota && <span class="mt-1.5 block font-medium text-ink">{p.nota}</span>}
										</p>
										<a href={`/cotizar?rama=${p.rama}&producto=${encodeURIComponent(p.nombre)}`} class="group inline-flex shrink-0 items-center gap-1.5 text-[1.0625rem] font-semibold">
											Cotizar
											<Icon name="arrowRight" class="size-[1.125rem] transition-transform duration-300 ease-out-expo group-hover:translate-x-1" strokeWidth={2} />
										</a>
									</div>
								</details>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</div>
</section>
