---
import { Image } from 'astro:assets';
import logo from '../assets/img/logo-brokers.jpg';
import Icon from './Icon.astro';
import { contacto, whatsappLink } from '../data/brokers';

const year = new Date().getFullYear();

const nav = [
	{ href: '/#coberturas', label: 'Seguros' },
	{ href: '/#aseguradoras', label: 'Aseguradoras' },
	{ href: '/#siniestros', label: 'Siniestros' },
	{ href: '/#personas', label: 'Equipo' },
	{ href: '/#contacto', label: 'Contacto' },
];

// Crédito del desarrollador (no es contenido de Brokers Asociados). El número vive en una variable pública: PUBLIC_CONTACTO_DEV (solo dígitos, con código de país).
const devWhatsapp = import.meta.env.PUBLIC_CONTACTO_DEV || '5492236801937';
const devMensaje = encodeURIComponent('Hola Lautaro, vi la página de Brokers Asociados y me gustaría una para mi negocio.');
const devWeb = 'https://lautarofullone.dev';

const mail = contacto.emails[0].email;
const fila = 'grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3';
const enlace = 'ix-link inline-flex min-h-12 items-center no-underline';
---

<footer class="pie con-grano bg-ink text-paper">
	<div class="pie-contenido mx-auto grid max-w-[84rem] gap-x-12 gap-y-12 px-4 pb-12 sm:px-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,3fr)_minmax(0,4fr)] lg:px-12">
		<!-- Marca y acciones principales -->
		<div>
			<div class="flex items-center gap-5">
				<Image src={logo} alt="" width={80} height={80} densities={[1, 2]} class="size-20 shrink-0 rounded-full ring-2 ring-paper/80" />
				<div>
					<p class="text-[1.5rem] font-bold [font-stretch:92%]">Brokers Asociados</p>
					<p class="mt-1 text-[1rem] text-on-dark">Productores asesores de seguros</p>
					<p class="text-[1rem] text-on-dark">Más de 35 años en Mar del Plata</p>
				</div>
			</div>

			<div class="mt-8 flex items-center gap-3">
				<a href="/cotizar" class="ix-accion ix-celeste inline-flex h-14 flex-1 items-center justify-between gap-6 px-6 text-[1.25rem] font-bold no-underline sm:max-w-[19rem]">
					Cotizá tu seguro
					<Icon name="arrowRight" class="ix-flecha size-6" strokeWidth={2} />
				</a>
				<a href={whatsappLink('Hola, quiero hacer una consulta.')} aria-label="Escribinos por WhatsApp" class="ix-accion ix-celeste grid size-14 shrink-0 place-items-center rounded-full no-underline">
					<Icon name="whatsapp" class="size-6" />
				</a>
			</div>
			<a href="/siniestros/denuncia" class="ix-sub mt-1 inline-flex min-h-12 items-center gap-2.5 text-[1.0625rem] font-medium text-paper no-underline">
				<span class="size-2.5 rounded-full bg-claim ring-2 ring-paper/80" aria-hidden="true"></span>
				Denunciar un siniestro
			</a>
		</div>

		<!-- Navegación: en el celular va después del contacto -->
		<nav aria-labelledby="pie-nav" class="order-3 lg:order-2">
			<h2 id="pie-nav" class="field-no border-t-2 border-paper/80 pt-3 text-on-dark">Este sitio</h2>
			<ul class="mt-2 text-[1.125rem] font-medium">
				{nav.map((n) => (
					<li><a href={n.href} class={enlace}>{n.label}</a></li>
				))}
			</ul>
		</nav>

		<!-- Contacto -->
		<div class="order-2 lg:order-3">
			<h2 class="field-no border-t-2 border-paper/80 pt-3 text-on-dark">Contacto</h2>
			<ul class="mt-4 space-y-1 text-[1.0625rem] text-on-dark">
				<li class={`${fila} items-start py-2`}>
					<Icon name="mapPin" class="mt-1 size-5" />
					<div>
						<p>{contacto.direccion}</p>
						<p>{contacto.ciudad}</p>
						<a href={contacto.mapa} target="_blank" rel="noopener" class="ix-link inline-flex min-h-12 items-center gap-1.5 font-semibold text-paper no-underline">
							Cómo llegar
							<Icon name="arrowUpRight" class="ix-flecha size-4" strokeWidth={2} />
							<span class="sr-only">(se abre en una pestaña nueva)</span>
						</a>
					</div>
				</li>
				<li class={`${fila} items-center`}>
					<Icon name="phone" class="size-5" />
					<a href={contacto.telefonoHref} class="ix-link inline-flex min-h-12 items-center font-semibold text-paper no-underline">{contacto.telefono}</a>
				</li>
				<li class={`${fila} items-center`}>
					<Icon name="mail" class="size-5" />
					<a href={`mailto:${mail}`} class="ix-link inline-flex min-h-12 items-center text-paper no-underline [overflow-wrap:anywhere]">{mail}</a>
				</li>
				<li class={`${fila} items-start py-2`}>
					<Icon name="clock" class="mt-1 size-5" />
					<p>{contacto.horario}</p>
				</li>
				<li class={`${fila} items-center`}>
					<Icon name="instagram" class="size-5" />
					<a href={contacto.instagram} target="_blank" rel="noopener" class="ix-link inline-flex min-h-12 items-center text-paper no-underline">{contacto.instagramUsuario}</a>
				</li>
			</ul>
		</div>

		<!-- Bloque obligatorio de la Superintendencia de Seguros de la Nación: alineado a las tres columnas -->
		<div class="order-4 border-2 border-paper/80 bg-paper text-ink lg:col-span-3 lg:grid lg:grid-cols-subgrid">
			<p class="flex items-center border-b-2 border-ink px-5 py-4 font-mono text-[0.875rem] font-medium uppercase tracking-[0.04em] lg:border-b-0 lg:border-r-2">Superintendencia de Seguros de la Nación</p>
			<div class="border-b border-rule px-5 py-4 lg:border-b-0 lg:border-r">
				<p class="text-[1rem] text-ink-2">Atención al asegurado</p>
				<p class="mt-1 text-[1.375rem] font-bold"><a href="tel:08006668400" class="ix-link inline-flex min-h-12 items-center no-underline">0800-666-8400</a></p>
			</div>
			<div class="px-5 py-4">
				<p class="text-[1rem] text-ink-2">Organismo de control</p>
				<p class="mt-1 text-[1.125rem] font-semibold"><a href="https://www.argentina.gob.ar/ssn" target="_blank" rel="noopener" class="ix-sub inline-flex min-h-12 items-center [overflow-wrap:anywhere]">www.argentina.gob.ar/SSN</a></p>
			</div>
		</div>
	</div>

	<!-- Barra única: © y crédito del desarrollador -->
	<div class="border-t border-paper/25">
		<div class="mx-auto flex max-w-[84rem] flex-col items-center gap-8 px-4 py-8 text-center sm:px-8 lg:flex-row lg:items-start lg:justify-between lg:text-left lg:px-12">
			<p class="text-[1rem] text-on-dark">© {year} Brokers Asociados</p>

			<div class="flex flex-col items-center gap-1 lg:items-end">
				<p class="text-[0.9375rem] text-on-dark">
					¿Te gustaría una página como esta?{' '}
					<a href={`https://wa.me/${devWhatsapp}?text=${devMensaje}`} target="_blank" rel="noopener" class="credito-venta relative inline-flex items-center gap-1.5 text-paper no-underline">
						<em class="ix-link pb-0.5">Hagamos la tuya.</em>
						<Icon name="whatsapp" class="ix-flecha size-3.5 [--ix-dist:2px]" />
						<span class="sr-only">(se abre en una pestaña nueva)</span>
					</a>
				</p>
				<a href={devWeb} target="_blank" rel="noopener" class="credito-firma relative inline-flex items-center gap-1.5 text-[0.875rem] text-on-dark/70 no-underline">
					<span>Creado por <span class="credito-nombre">Lautaro Fullone</span></span>
					<Icon name="externalLink" class="ix-flecha size-3.5 [--ix-dist:2px]" strokeWidth={2} />
					<span class="sr-only">(se abre en una pestaña nueva)</span>
				</a>
			</div>
		</div>
	</div>
</footer>

<style>
	/* Único degradé de la web: ink arriba (como el Cierre) y ink-deep hacia la barra inferior. El aire superior sigue el ritmo de las secciones (64 / 80 / 96px) */
	.pie {
		background-image: var(--grano), linear-gradient(180deg, var(--color-ink) 0%, var(--color-ink) 30%, var(--color-ink-deep) 100%);
		background-size: var(--grano-tam) var(--grano-tam), auto;
	}
	.pie-contenido { padding-top: 4rem; }
	@media (min-width: 640px) { .pie-contenido { padding-top: 5rem; } }
	@media (min-width: 1024px) { .pie-contenido { padding-top: 6rem; } }

	/* Áreas táctiles de 48px sin separar las dos líneas del crédito */
	.credito-venta::after,
	.credito-firma::after {
		content: '';
		position: absolute;
		inset: -0.8125rem -0.25rem;
	}
	.credito-nombre { transition: color var(--ix-color) var(--ease-out-expo); }
	.credito-firma:focus-visible .credito-nombre { color: var(--color-paper); }
	.credito-venta:focus-visible .ix-link { background-size: 100% 1px; background-position: 0% 100%; }
	@media (hover: hover) {
		.credito-firma:hover .credito-nombre { color: var(--color-paper); }
		.credito-venta:hover .ix-link { background-size: 100% 1px; background-position: 0% 100%; }
	}
	@media (prefers-reduced-motion: reduce) {
		.credito-nombre { transition: none; }
	}
</style>
