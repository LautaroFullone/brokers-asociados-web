---
import Icon from './Icon.astro';
import { contacto, whatsappLink } from '../data/brokers';

const info = contacto.emails[0].email;
const fila = 'grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3 py-4';
---

	<dl class="border-t-2 border-ink text-[1.125rem]">
		<div class={`${fila} border-b border-rule`}>
			<dt class="pt-0.5"><Icon name="mapPin" class="size-5" /><span class="sr-only">Dirección</span></dt>
			<dd>
				<span class="font-semibold">{contacto.direccion}</span>, {contacto.ciudad}
				<a href={contacto.mapa} target="_blank" rel="noopener" class="mt-1 block w-fit font-medium">Cómo llegar</a>
			</dd>
		</div>
		<div class={`${fila} border-b border-rule`}>
			<dt class="pt-0.5"><Icon name="clock" class="size-5" /><span class="sr-only">Horario</span></dt>
			<dd>
				{contacto.horario}
				<span class="mt-1 flex items-center gap-2 font-mono text-[0.9375rem] text-ink-2" data-horario>
					<span class="size-2.5 rounded-full bg-rule" data-horario-dot aria-hidden="true"></span>
					<span data-horario-texto></span>
				</span>
			</dd>
		</div>
		<div class={`${fila} border-b border-rule`}>
			<dt class="pt-0.5"><Icon name="phone" class="size-5" /><span class="sr-only">Teléfono</span></dt>
			<dd><a href={contacto.telefonoHref} class="font-semibold no-underline hover:underline">{contacto.telefono}</a></dd>
		</div>
		<div class={`${fila} border-b border-rule`}>
			<dt class="pt-0.5"><Icon name="mail" class="size-5" /><span class="sr-only">Email</span></dt>
			<dd><a href={`mailto:${info}`} class="[overflow-wrap:anywhere] hover:no-underline">{info}</a></dd>
		</div>
		<div class={`${fila} border-b border-rule`}>
			<dt class="pt-0.5"><Icon name="instagram" class="size-5" /><span class="sr-only">Instagram</span></dt>
			<dd><a href={contacto.instagram} target="_blank" rel="noopener" class="hover:no-underline">{contacto.instagramUsuario}</a></dd>
		</div>
	</dl>
	<a
		href={whatsappLink('Hola, quiero hacer una consulta.')}
		class="group mt-8 inline-flex items-center justify-between gap-4 bg-seal px-6 py-4.5 text-[1.25rem] font-semibold text-paper no-underline transition-colors duration-200 hover:bg-seal-deep sm:min-w-[24rem]"
	>
		<span class="inline-flex items-center gap-3"><Icon name="whatsapp" class="size-6" />Escribinos por WhatsApp</span>
		<Icon name="arrowRight" class="size-6 transition-transform duration-300 ease-out-expo group-hover:translate-x-1" strokeWidth={2} />
	</a>
