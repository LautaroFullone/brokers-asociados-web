---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { equipo, productores, whatsappLink } from '../data/brokers';

const slug = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

// Retratos 4:5 en blanco y negro: src/assets/equipo/<slug>.(jpg|png|webp); en color (hover): src/assets/equipo/color/<slug>.*
const fotos = import.meta.glob<ImageMetadata>('../assets/equipo/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' });
const foto = (nombre: string) => Object.entries(fotos).find(([ruta]) => ruta.includes(`/${slug(nombre)}.`))?.[1];
const fotosColor = import.meta.glob<ImageMetadata>('../assets/equipo/color/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' });
const fotoColor = (nombre: string) => Object.entries(fotosColor).find(([ruta]) => ruta.includes(`/${slug(nombre)}.`))?.[1];

// Pendiente de confirmar con el cliente: WhatsApp individual de cada persona. Mientras tanto, el general.
const wa = (nombre: string) => whatsappLink(`Hola ${nombre.split(' ')[0]}, quiero hacer una consulta.`);

const oficina = equipo.map((p) => ({ nombre: p.nombre, rol: p.area }));
// Jorge Couto e Ignacio Victorel también figuran como productores: se muestran una sola vez, con la oficina
const enOficina = new Set(oficina.map((p) => p.nombre));
const productoresAsesores = productores.filter((n) => !enOficina.has(n)).map((nombre) => ({ nombre, rol: 'Productor asesor' }));

const grupos = [
	{ id: 'oficina', titulo: 'En la oficina', personas: oficina },
	{ id: 'productores', titulo: 'Productores asesores', personas: productoresAsesores },
];
---

<section id="personas" class="border-t-2 border-ink" aria-labelledby="personas-titulo">
	<div class="mx-auto max-w-[84rem] px-4 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
		<h2 id="personas-titulo" class="text-[clamp(2.25rem,1.6rem+2.6vw,3.75rem)] font-bold">Te atiende una persona</h2>

		{grupos.map((g) => (
			<div class="mt-12 first-of-type:mt-10">
				<h3 class="field-no border-t-2 border-ink pt-3 text-ink-2" id={`grupo-${g.id}`}>{g.titulo}</h3>
				<ul class="tira mt-4 flex snap-x snap-proximity gap-1 overflow-x-auto pb-4" tabindex="0" role="list" aria-labelledby={`grupo-${g.id}`}>
					{g.personas.map((p) => {
						const img = foto(p.nombre);
						const imgColor = fotoColor(p.nombre);
						return (
							<li class="persona group relative w-[14.5rem] shrink-0 snap-start sm:w-[16rem]">
								<div class="marco relative aspect-[4/5] overflow-hidden">
									{img ? (
										<>
											<Image src={img} alt="" widths={[320, 640]} sizes="256px" class="size-full object-cover" loading="lazy" />
											{imgColor && (
												<Image src={imgColor} alt="" aria-hidden="true" widths={[320, 640]} sizes="256px" class="color absolute inset-0 size-full object-cover" loading="lazy" decoding="async" />
											)}
										</>
									) : (
										<svg class="size-full text-rule" viewBox="0 0 120 160" fill="currentColor" aria-hidden="true" preserveAspectRatio="xMidYMax slice">
											<circle cx="60" cy="62" r="23" />
											<path d="M10 160c0-36 21-58 50-58s50 22 50 58z" />
										</svg>
									)}
								</div>
									<div class="info">
										<p class="field-no text-on-dark">{p.rol}</p>
										<p class="mt-1 text-[1.25rem] font-bold leading-tight">{p.nombre}</p>
										<a href={wa(p.nombre)} aria-label={`Escribirle a ${p.nombre} por WhatsApp`} class="boton-wa mt-3 grid size-11 place-items-center rounded-full no-underline">
											<Icon name="whatsapp" class="size-5" />
										</a>
									</div>
							</li>
						);
					})}
				</ul>
			</div>
		))}
	</div>
</section>

<style>
	.tira {
		scrollbar-width: thin;
		scrollbar-color: var(--color-ink) transparent;
	}
	/* Gris neutro de los retratos (#ececec arriba, #dedede abajo): el azul pálido de rule-soft desentonaba al lado */
	.marco { background: linear-gradient(#ececec, #dedede); }
	.boton-wa {
		background: #a8dadc;
		color: #0f3554;
	}

	/* Panel de datos: en pantallas con mouse sube sobre la foto; en el resto queda siempre visible debajo */
	.info {
		position: absolute;
		inset: auto 0 0 0;
		background: var(--color-ink);
		color: var(--color-paper);
		padding: 1rem;
	}
	/* La capa color solo existe donde hay hover: en táctil no se pinta y, al ser display:none, ni se descarga */
	.marco :global(.color) { display: none; }
	@media (hover: hover) and (min-width: 768px) {
		.persona { overflow: hidden; }
		.marco :global(.color) {
			display: block;
			opacity: 0;
			transition: opacity 0.4s var(--ease-out-expo), transform 0.7s var(--ease-out-expo);
		}
		.persona:hover .marco :global(.color),
		.persona:focus-within .marco :global(.color) {
			opacity: 1;
		}
		.info {
			transform: translateY(101%);
			transition: transform 0.5s var(--ease-out-expo);
		}
		.persona:hover .info,
		.persona:focus-within .info {
			transform: translateY(0);
		}
		.marco :global(img:not(.color)),
		.marco svg {
			transition: transform 0.7s var(--ease-out-expo);
		}
		.persona:hover .marco :global(img),
		.persona:focus-within .marco :global(img),
		.persona:hover .marco svg,
		.persona:focus-within .marco svg {
			transform: scale(1.03);
		}
	}
	@media not ((hover: hover) and (min-width: 768px)) {
		.info {
			position: static;
			background: transparent;
			color: var(--color-ink);
			padding: 0.75rem 0 0;
		}
		.info :global(.field-no) { color: var(--color-ink-2); }
		/* Sobre el papel el celeste pierde borde: el botón pasa a tinta */
		.boton-wa { background: var(--color-ink); color: var(--color-paper); }
	}
	@media (prefers-reduced-motion: reduce) {
		.info, .marco :global(img), .marco :global(.color), .marco svg { transition: none; }
		.persona:hover .marco :global(img), .persona:focus-within .marco :global(img),
		.persona:hover .marco svg, .persona:focus-within .marco svg { transform: none; }
	}
</style>
