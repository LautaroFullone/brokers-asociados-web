---
import PersonaCard from './PersonaCard.astro';
import { equipo, productores, whatsappLink } from '../data/brokers';

const slug = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

// Retratos 4:5 en gris: src/assets/equipo/<slug>.(jpg|png|webp); en color (hover): src/assets/equipo/color/<slug>.*
const fotos = import.meta.glob<ImageMetadata>('../assets/equipo/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' });
const fotosColor = import.meta.glob<ImageMetadata>('../assets/equipo/color/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' });
const buscar = (mapa: Record<string, ImageMetadata>, nombre: string) => Object.entries(mapa).find(([ruta]) => ruta.includes(`/${slug(nombre)}.`))?.[1];

// Pendiente de confirmar con el cliente: WhatsApp individual de cada persona. Mientras tanto, el general.
const wa = (nombre: string) => whatsappLink(`Hola ${nombre.split(' ')[0]}, quiero hacer una consulta.`);

const persona = (nombre: string, rol: string) => ({ nombre, rol, href: wa(nombre), foto: buscar(fotos, nombre), fotoColor: buscar(fotosColor, nombre) });

// Jorge e Ignacio figuran en la oficina y como productores: se muestran una sola vez. Todos van en el mismo carrusel.
const oficina = equipo.map((p) => persona(p.nombre, p.area));
const enOficina = new Set(oficina.map((p) => p.nombre));
const productoresAsesores = productores.filter((n) => !enOficina.has(n)).map((n) => persona(n, 'Productor asesor'));

// Dos filas parejas con la oficina repartida entre ambas
const corte = Math.floor(productoresAsesores.length / 2);
const filaDe = (oficinaIdx: number[], resto: typeof productoresAsesores) => {
	const fila = [...resto];
	fila.splice(0, 0, oficina[oficinaIdx[0]]);
	fila.splice(5, 0, oficina[oficinaIdx[1]]);
	return fila;
};
const filas = [
	{ id: 1, personas: filaDe([0, 2], productoresAsesores.slice(0, corte)) },
	{ id: 2, personas: filaDe([1, 3], productoresAsesores.slice(corte)) },
];
// La segunda vuelta alimenta el bucle: sin lectores de pantalla ni foco
const vueltas = [false, true];
---

<section id="personas" class="border-t-2 border-ink" aria-labelledby="personas-titulo" data-equipo>
	<div class="mx-auto max-w-[84rem] px-4 pt-16 sm:px-8 sm:pt-20 lg:px-12 lg:pt-24">
		<div class="flex items-end justify-between gap-6">
			<h2 id="personas-titulo" class="text-[clamp(2.25rem,1.6rem+2.6vw,3.75rem)] font-bold">Nuestro equipo</h2>
			<!-- Control de pausa discreto (WCAG 2.2.2): solo el ícono, con nombre accesible -->
			<button type="button" class="pausa-equipo grid size-11 shrink-0 place-items-center border-[1.5px] border-rule text-ink-2 ix-control hover:border-ink hover:text-ink focus-visible:border-ink focus-visible:text-ink" aria-label="Pausar el carrusel del equipo" data-pausa-equipo>
				<svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<g data-icono-pausa><rect x="5" y="4" width="5" height="16" /><rect x="14" y="4" width="5" height="16" /></g>
					<path data-icono-play d="M7 4l13 8-13 8z" style="display:none" />
				</svg>
			</button>
		</div>
	</div>

	<div class="mx-auto mb-16 mt-10 max-w-[84rem] space-y-2 px-4 sm:mb-20 sm:mt-12 sm:px-8 lg:mb-24 lg:px-12">
		{filas.map((f) => (
			<div class:list={['fila', `fila-${f.id}`]} data-fila>
				<div class="pista">
					{vueltas.map((copia) => (
						<ul
							class:list={['vuelta', copia && 'vuelta-copia']}
							role="list"
							aria-label={copia ? undefined : `Equipo, fila ${f.id} de 2`}
							aria-hidden={copia ? 'true' : undefined}
						>
							{f.personas.map((p) => <PersonaCard {...p} sinFoco={copia} />)}
						</ul>
					))}
				</div>
			</div>
		))}
	</div>
</section>

<style is:global>
	/* ——— Retrato ——— */
	#personas .persona { position: relative; display: flex; flex-direction: column; }
	#personas .marco {
		position: relative;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: linear-gradient(#ececec, #dedede);
	}
	#personas .marco img { display: block; width: 100%; height: 100%; object-fit: cover; }
	#personas .foto-color { position: absolute; inset: 0; display: none; }
	#personas .silueta { display: block; width: 100%; height: 100%; color: var(--color-rule); }

	/* Con mouse la foto pasa a color y se acerca al hover y al foco; con táctil la capa color no existe (ni se descarga) hasta el primer toque */
	@media (hover: hover) {
		#personas .foto-color {
			display: block;
			opacity: 0;
			transition: opacity 0.4s var(--ease-out-expo);
		}
		#personas .marco img { transition: transform 0.7s var(--ease-out-expo); }
		#personas .foto-color { transition: opacity 0.4s var(--ease-out-expo), transform 0.7s var(--ease-out-expo); }
		#personas .persona:hover .foto-color,
		#personas .persona:focus-within .foto-color { opacity: 1; }
		#personas .persona:hover .marco img,
		#personas .persona:focus-within .marco img { transform: scale(1.03); }
	}
	#personas .persona.tocada .foto-color {
		display: block;
		animation: equipo-fundido 0.4s var(--ease-out-expo);
	}
	@keyframes equipo-fundido { from { opacity: 0; } }

	/* ——— Datos ——— */
	#personas .datos { display: flex; align-items: flex-end; justify-content: space-between; gap: 0.5rem; padding: 0.75rem; }
	#personas .nombre { margin-top: 0.125rem; font-size: 1.125rem; font-weight: 700; line-height: 1.15; }
	#personas .rol { font-size: 0.875rem; }
	/* Celular: las tarjetas miden ~126px y no queda lugar junto al nombre. El WhatsApp se apoya sobre la regla de la etiqueta,
	   en la foto, para que ningún nombre largo pase por debajo del botón */
	@media (max-width: 639px) {
		#personas .fila .datos { padding: 0.625rem; }
		#personas .fila .boton-wa {
			position: absolute;
			right: 0.5rem;
			bottom: calc(100% + 0.5rem);
		}
		#personas .fila .nombre { font-size: 1rem; }
		#personas .fila .rol { font-size: 0.875rem; letter-spacing: 0; min-height: 2lh; } /* "Productor asesor" ocupa dos renglones: todos reservan dos, así los nombres quedan alineados */
	}
	@media (min-width: 640px) {
		#personas .nombre { font-size: 1.25rem; }
		#personas .rol { font-size: 0.875rem; }
	}

	/* ——— Filas en bucle ——— */
	#personas .fila {
		--n: 2.5;
		--gap: 0.5rem;
		container-type: inline-size;
		overflow: clip;
		-webkit-mask-image: linear-gradient(90deg, transparent, black 3%, black 97%, transparent);
		mask-image: linear-gradient(90deg, transparent, black 3%, black 97%, transparent);
	}
	@media (min-width: 640px) { #personas .fila { --n: 3.5; } }
	@media (min-width: 1024px) { #personas .fila { --n: 4.5; } }
	#personas .pista {
		position: relative;
		display: flex;
		width: max-content;
		animation: equipo-corre 60s linear infinite;
	}
	#personas .fila-2 .pista { animation-direction: reverse; }
	@keyframes equipo-corre { to { transform: translateX(-50%); } }
	#personas .vuelta { display: flex; margin: 0; padding: 0; list-style: none; }
	#personas .vuelta > .persona {
		flex: none;
		box-sizing: border-box;
		/* La separación es relleno de la tarjeta: no hay zonas muertas entre retratos donde la fila se frena pero la foto no se colorea */
		padding-right: var(--gap);
		width: calc((100cqw + var(--gap)) / var(--n));
	}
	/* Se frena con el foco de teclado, con el mouse o mientras hay una foto tocada */
	#personas[data-pausado] .pista,
	#personas .fila:focus-within .pista,
	#personas .fila:has(.tocada) .pista { animation-play-state: paused; }
	@media (hover: hover) {
		#personas .fila:hover .pista { animation-play-state: paused; }
	}

	/* Sin movimiento: cada fila se recorre a mano, con snap */
	@media (prefers-reduced-motion: reduce) {
		#personas .fila {
			overflow-x: auto;
			scroll-snap-type: x proximity;
			-webkit-mask-image: none;
			mask-image: none;
			scrollbar-width: thin;
			scrollbar-color: var(--color-ink) transparent;
		}
		#personas .pista { animation: none; transform: none; }
		#personas .vuelta-copia, .pausa-equipo { display: none; }
		#personas .vuelta > .persona { scroll-snap-align: start; }
		#personas .foto-color, #personas .marco img { transition: none; }
		#personas .persona:hover .marco img, #personas .persona:focus-within .marco img { transform: none; }
		#personas .persona.tocada .foto-color { animation: none; }
	}

	/* ——— Etiqueta sobre la foto: papel con regla de 2px en tinta, superpuesta al borde inferior del retrato ——— */
	#personas .datos {
		position: relative;
		z-index: 1;
		margin: -2.75rem 0.5rem 0;
		border-top: 2px solid var(--color-ink);
		background: var(--grano) 0 0 / var(--grano-tam) var(--grano-tam), var(--color-paper);
		color: var(--color-ink);
	}
	#personas .rol { color: var(--color-ink-2); }
</style>

<script>
	const raiz = document.querySelector<HTMLElement>('[data-equipo]')!;

	// Pausa explícita del carrusel
	const botonPausa = raiz.querySelector<HTMLButtonElement>('[data-pausa-equipo]')!;
	botonPausa.addEventListener('click', () => {
		const pausado = raiz.toggleAttribute('data-pausado');
		botonPausa.setAttribute('aria-label', pausado ? 'Reanudar el carrusel del equipo' : 'Pausar el carrusel del equipo');
		botonPausa.querySelector<SVGElement>('[data-icono-pausa]')!.style.display = pausado ? 'none' : '';
		botonPausa.querySelector<SVGElement>('[data-icono-play]')!.style.display = pausado ? '' : 'none';
	});

	// Táctil: la foto pasa a color al tocarla (una a la vez)
	if (matchMedia('(hover: none)').matches) {
		raiz.addEventListener('click', (e) => {
			const card = (e.target as HTMLElement).closest<HTMLElement>('.persona');
			if (!card || (e.target as HTMLElement).closest('a')) return;
			const ya = card.classList.contains('tocada');
			raiz.querySelectorAll('.tocada').forEach((c) => c.classList.remove('tocada'));
			if (!ya) card.classList.add('tocada');
		});
	}

	// Teclado: la fila se frena y, si la persona enfocada quedó fuera de vista, la trae a la ventana
	if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
		raiz.querySelectorAll<HTMLElement>('[data-fila]').forEach((fila) => {
			const pista = fila.querySelector<HTMLElement>('.pista')!;
			const inversa = fila.classList.contains('fila-2');
			fila.addEventListener('focusin', (e) => {
				const card = (e.target as HTMLElement).closest<HTMLElement>('.persona');
				const anim = pista.getAnimations()[0];
				if (!card || !anim) return;
				const r = card.getBoundingClientRect();
				const f = fila.getBoundingClientRect();
				if (r.left >= f.left && r.right <= f.right) return;
				const margen = f.width * 0.05;
				const progreso = Math.min(Math.max((card.offsetLeft - margen) / (pista.scrollWidth / 2), 0), 0.999);
				const duracion = Number(anim.effect!.getComputedTiming().duration);
				anim.currentTime = (inversa ? 1 - progreso : progreso) * duracion;
			});
		});
	}
</script>
