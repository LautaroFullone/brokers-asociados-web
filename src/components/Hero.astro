---
import { Image } from 'astro:assets';
import HeroCtas from './HeroCtas.astro';
import rambla from '../assets/img/rambla-mar-del-plata.jpg';

const titulo = ['Tu seguro,', 'bien elegido.'];
const bajada = 'Asesoramos y gestionamos los seguros de personas y empresas en Mar del Plata hace más de 35 años.';
---

<section data-hero class="hero hero-a relative isolate flex min-h-[clamp(40rem,94svh,56rem)] flex-col overflow-hidden bg-ink text-paper" aria-labelledby="hero-titulo">
	<Image
		src={rambla}
		alt=""
		widths={[960, 1600, 2560]}
		sizes="100vw"
		loading="eager"
		fetchpriority="high"
		class="hero-foto absolute inset-0 -z-20 size-full object-cover object-[30%_55%] max-lg:object-[22%_50%]"
	/>
	<div class="hero-velo absolute inset-0 -z-10" aria-hidden="true"></div>

	<div class="relative mx-auto flex w-full max-w-[84rem] flex-1 items-center px-4 pt-32 pb-24 sm:px-8 lg:px-12 lg:pb-20">
		<div class="max-w-[46rem]">
			<h1 id="hero-titulo" class="text-[clamp(3.25rem,1.9rem+5.2vw,6.25rem)] font-bold [font-stretch:84%]">
				{titulo[0]}<br />{titulo[1]}
			</h1>
			<p class="mt-6 max-w-[46ch] text-[1.25rem] leading-[1.5] text-on-dark sm:text-[1.375rem]">{bajada}</p>
			<div class="mt-10"><HeroCtas tono="oscuro" /></div>
		</div>
	</div>

	<p class="absolute right-4 bottom-4 max-w-[60%] text-right font-mono text-[0.875rem] text-on-dark sm:right-8 lg:right-12">
		<span class="max-sm:hidden">Rambla de Mar del Plata · </span>Foto: Ezarate, CC BY-SA 4.0
	</p>
</section>

<style>
	.hero-velo {
		background:
			linear-gradient(90deg, rgb(15 58 92 / 0.9) 0%, rgb(24 78 119 / 0.78) 34%, rgb(24 78 119 / 0.25) 64%, rgb(24 78 119 / 0) 82%),
			linear-gradient(0deg, rgb(15 58 92 / 0.55) 0%, rgb(15 58 92 / 0) 22%),
			linear-gradient(180deg, rgb(15 58 92 / 0.78) 0%, rgb(15 58 92 / 0.4) 4.5rem, rgb(15 58 92 / 0) 8rem);
	}
	@media (max-width: 1023px) {
		.hero-velo {
			background: linear-gradient(180deg, rgb(15 58 92 / 0.86) 0%, rgb(15 58 92 / 0.8) 52%, rgb(15 58 92 / 0.28) 76%, rgb(15 58 92 / 0.12) 100%);
		}
	}
	.hero-foto {
		transform-origin: 30% 60%;
		animation: costa 32s ease-in-out infinite alternate;
		will-change: transform;
	}
	@keyframes costa {
		from {
			transform: scale(1.14) translate3d(1.5%, 0.5%, 0);
		}
		to {
			transform: scale(1) translate3d(0, 0, 0);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-foto { animation: none; transform: none; }
	}
</style>
