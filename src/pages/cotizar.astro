---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Icon from '../components/Icon.astro';
import Stamp from '../components/Stamp.astro';
import tira from '../assets/img/guilloche-tira.svg?url';
import {
	ramas,
	productores,
	marcasVehiculo,
	tiposInmueble,
	destinatariosAP,
	otrosSeguros,
	contacto,
	whatsappLink,
} from '../data/brokers';

const inputBase =
	'block w-full border-[1.5px] border-rule bg-sheet px-3.5 py-2.5 text-[1.125rem] text-ink placeholder:text-[#5f7385] transition-colors duration-200 hover:border-ink focus:border-ink focus:outline-none focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-teal aria-[invalid=true]:border-claim';
const tile =
	'group relative flex min-h-12 cursor-pointer items-center gap-3 border-[1.5px] border-rule-soft bg-sheet px-3 py-2 transition-colors duration-200 hover:border-ink has-checked:border-ink has-checked:bg-wash has-focus-visible:outline-3 has-focus-visible:outline-offset-2 has-focus-visible:outline-teal';
const box =
	'grid size-6 shrink-0 place-items-center border-2 border-ink bg-sheet text-paper transition-colors duration-200 peer-checked:bg-ink';
const check =
	'size-4 scale-50 opacity-0 transition-[opacity,scale] duration-200 ease-out-expo group-has-checked:scale-100 group-has-checked:opacity-100';
const row = 'grid grid-cols-[2.75rem_minmax(0,1fr)] border-b border-rule sm:grid-cols-[3.25rem_minmax(0,1fr)]';
const no = 'field-no border-r border-rule pt-3.5 text-center text-ink-2';
const legend = 'float-left mb-2 w-full text-[1.125rem] font-semibold';
const err = 'mt-1.5 hidden text-[1rem] font-medium text-claim';
const label = 'mb-1 block text-[1rem] text-ink-2';

const anioActual = new Date().getFullYear();
const anios = Array.from({ length: anioActual + 1 - 1995 + 1 }, (_, i) => anioActual + 1 - i);
const hoy = new Intl.DateTimeFormat('es-AR', { dateStyle: 'long', timeZone: 'America/Argentina/Buenos_Aires' }).format(new Date());

const filasCaratula = [
	{ key: 'rama', label: 'Rama' },
	{ key: 'item', label: 'Bien' },
	{ key: 'nombre', label: 'Asegurado' },
	{ key: 'telefono', label: 'Teléfono' },
	{ key: 'productor', label: 'Productor' },
];
---

<Layout
	title="Pedí tu cotización · Brokers Asociados"
	description="Cotizá tu seguro de auto, hogar, comercio, accidentes personales y más con productores asesores de Mar del Plata. Pocos datos y un asesor te llama."
>
	<Header />
	<main id="contenido" class="relative overflow-hidden pt-[4.5rem]">
		<div class="relative mx-auto grid max-w-[84rem] grid-cols-1 gap-x-14 gap-y-10 px-4 pt-8 pb-16 sm:px-8 lg:grid-cols-[minmax(0,1fr)_29.5rem] lg:px-12 lg:pt-10 lg:pb-24">
			<section aria-labelledby="pedido-titulo">
				<a href="/" class="ix-sub inline-flex items-center gap-2 text-[1rem] font-medium">
					<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
					Volver al inicio
				</a>
				<h1 id="pedido-titulo" class="mt-5 text-[clamp(2.5rem,1.8rem+2.8vw,4rem)] font-bold [font-stretch:84%]">Pedí tu cotización</h1>
				<p class="mt-3 max-w-[44ch] text-[1.25rem] text-ink-2">Con pocos datos alcanza: un asesor te llama con la propuesta.</p>

				<div id="pedido" class="mt-8 border-2 border-ink bg-sheet">
					<form id="pedido-form" data-pedido novalidate class="contents">
						<!-- 01 · Rama -->
						<div class={row}>
							<span class={no} aria-hidden="true">01</span>
							<fieldset class="px-4 pt-3 pb-3.5 sm:px-5" data-grupo="rama" aria-describedby="err-rama">
								<legend class={legend}>¿Qué querés asegurar?</legend>
								<div class="clear-both grid grid-cols-1 gap-2 sm:grid-cols-2">
									{ramas.map((r) => (
										<label class={tile}>
											<input type="radio" name="rama" value={r.id} data-label={r.label} class="peer sr-only" />
											<span class={box} aria-hidden="true"><Icon name="check" class={check} strokeWidth={3} /></span>
											<span class="text-[1.125rem] font-medium leading-tight">{r.label}</span>
										</label>
									))}
								</div>
								<p id="err-rama" class={err} data-error="rama">Elegí qué querés asegurar.</p>
							</fieldset>
						</div>

						<!-- 02 · Datos de la rama -->
						<div class={row}>
							<span class={no} aria-hidden="true">02</span>
							<div class="px-4 pt-3 pb-4 sm:px-5">
								<p class="text-[1.125rem] text-ink-2" data-rama-vacia>Elegí primero qué querés asegurar.</p>

								<fieldset data-rama-campos="auto" hidden>
									<legend class={legend}>Tu vehículo</legend>
									<div class="clear-both grid grid-cols-1 gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_8.5rem]">
										<div>
											<label for="c-marca" class={label}>Marca</label>
											<input id="c-marca" name="marca" list="c-marcas" aria-describedby="err-marca" autocomplete="off" class={inputBase} placeholder="Ej.: Volkswagen" required />
											<datalist id="c-marcas">{marcasVehiculo.map((m) => <option value={m} />)}</datalist>
											<p id="err-marca" class={err} data-error="marca">Escribí la marca.</p>
										</div>
										<div>
											<label for="c-modelo" class={label}>Modelo</label>
											<input id="c-modelo" name="modelo" aria-describedby="err-modelo" autocomplete="off" class={inputBase} placeholder="Ej.: Gol Trend" required />
											<p id="err-modelo" class={err} data-error="modelo">Escribí el modelo.</p>
										</div>
										<div>
											<label for="c-anio" class={label}>Año</label>
											<div class="relative">
												<select id="c-anio" name="anio" aria-describedby="err-anio" class={`${inputBase} appearance-none pr-9`} required>
													<option value="">Año</option>
													{anios.map((a) => <option value={a}>{a}</option>)}
													<option value="Anterior a 1995">Antes de 1995</option>
												</select>
												<svg class="pointer-events-none absolute top-1/2 right-3 size-5 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
											</div>
											<p id="err-anio" class={err} data-error="anio">Elegí el año.</p>
										</div>
									</div>
								</fieldset>

								<fieldset data-rama-campos="hogar" hidden>
									<legend class={legend}>Tu vivienda o comercio</legend>
									<div class="clear-both grid grid-cols-2 gap-2" role="radiogroup" aria-label="Tipo de inmueble" data-grupo="tipo" aria-describedby="err-tipo">
										{tiposInmueble.map((t) => (
											<label class={tile}>
												<input type="radio" name="tipo" value={t} class="peer sr-only" required />
												<span class={box} aria-hidden="true"><Icon name="check" class={check} strokeWidth={3} /></span>
												<span class="text-[1.125rem] font-medium">{t}</span>
											</label>
										))}
									</div>
									<p id="err-tipo" class={err} data-error="tipo">Elegí el tipo.</p>
									<div class="mt-3 max-w-[14rem]">
										<label for="c-cp" class={label}>Código postal</label>
										<input id="c-cp" name="cp" aria-describedby="err-cp" inputmode="numeric" autocomplete="postal-code" maxlength="8" class={inputBase} placeholder="Ej.: 7600" required />
										<p id="err-cp" class={err} data-error="cp">Escribí el código postal.</p>
									</div>
								</fieldset>

								<fieldset data-rama-campos="accidentes" hidden>
									<legend class={legend}>¿Para quién es el seguro?</legend>
									<div class="clear-both grid grid-cols-1 gap-2 sm:grid-cols-3" role="radiogroup" aria-label="Para quién es el seguro" data-grupo="para" aria-describedby="err-para">
										{destinatariosAP.map((d) => (
											<label class={tile}>
												<input type="radio" name="para" value={d} class="peer sr-only" required />
												<span class={box} aria-hidden="true"><Icon name="check" class={check} strokeWidth={3} /></span>
												<span class="text-[1.125rem] font-medium">{d}</span>
											</label>
										))}
									</div>
									<p id="err-para" class={err} data-error="para">Elegí para quién es.</p>
								</fieldset>

								<fieldset data-rama-campos="otro" hidden>
									<legend class={legend}>¿Qué seguro necesitás?</legend>
									<div class="clear-both relative max-w-[26rem]">
										<label for="c-seguro" class="sr-only">Seguro</label>
										<select id="c-seguro" name="seguro" aria-describedby="err-seguro" class={`${inputBase} appearance-none pr-10`} required>
											<option value="">Elegí una opción</option>
											{otrosSeguros.map((s) => <option value={s}>{s}</option>)}
										</select>
										<svg class="pointer-events-none absolute top-1/2 right-3.5 size-5 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
									</div>
									<p id="err-seguro" class={err} data-error="seguro">Elegí qué seguro necesitás.</p>
									<div class="mt-3">
										<label for="c-comentario" class={label}>¿Algo que debamos saber? <span class="text-ink-2">Opcional</span></label>
										<textarea id="c-comentario" name="comentario" rows="2" class={`${inputBase} resize-y`}></textarea>
									</div>
								</fieldset>
							</div>
						</div>

						<!-- 03 · Contacto -->
						<div class={row}>
							<span class={no} aria-hidden="true">03</span>
							<fieldset class="px-4 pt-3 pb-4 sm:px-5">
								<legend class={legend}>Tus datos</legend>
								<div class="clear-both flex items-center justify-between gap-4 bg-wash px-3.5 py-3 text-[1.125rem]" data-contacto-conocido hidden>
									<span><strong class="font-semibold" data-conocido-nombre></strong> · <span data-conocido-tel></span></span>
									<button type="button" class="ix-sub font-medium" data-contacto-editar>Cambiar</button>
								</div>
								<div class="clear-both grid grid-cols-1 gap-3 sm:grid-cols-2" data-contacto-campos>
									<div>
										<label for="c-nombre" class={label}>Nombre</label>
										<input id="c-nombre" name="nombre" aria-describedby="err-nombre" autocomplete="name" class={inputBase} required />
										<p id="err-nombre" class={err} data-error="nombre">Escribí tu nombre.</p>
									</div>
									<div>
										<label for="c-tel" class={label}>Teléfono o celular</label>
										<input id="c-tel" name="telefono" aria-describedby="err-telefono" type="tel" inputmode="tel" autocomplete="tel" placeholder="Ej.: 223 555-1234" class={inputBase} required />
										<p id="err-telefono" class={err} data-error="telefono">Revisá el número: con característica, por ejemplo 223 555-1234.</p>
									</div>
								</div>
							</fieldset>
						</div>

						<!-- 04 · Productor -->
						<div class="grid grid-cols-[2.75rem_minmax(0,1fr)] sm:grid-cols-[3.25rem_minmax(0,1fr)]">
							<span class={no} aria-hidden="true">04</span>
							<div class="px-4 pt-3 pb-4 sm:px-5">
								<label for="c-productor" class="mb-2 flex flex-wrap items-baseline gap-x-3 text-[1.125rem] font-semibold">
									¿Ya tenés productor? <span class="font-normal text-ink-2">Opcional</span>
								</label>
								<div class="relative">
									<select id="c-productor" name="productor" class={`${inputBase} appearance-none pr-10`}>
										<option value="">No tengo productor</option>
										<optgroup label="Sí, mi productor es:">{productores.map((p) => <option value={p}>{p}</option>)}</optgroup>
									</select>
									<svg class="pointer-events-none absolute top-1/2 right-3.5 size-5 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
								</div>
							</div>
						</div>

						<button type="submit" class="ix-accion ix-ink flex w-full items-center justify-between gap-4 px-5 py-4 max-lg:hidden text-left text-[1.25rem] font-semibold sm:px-6 sm:text-[1.375rem]">
							<span data-enviar-label>Pedir cotización</span>
							<Icon name="arrowRight" class="ix-flecha size-6 shrink-0" strokeWidth={2} />
						</button>
					</form>

					<!-- Enviado (demo: no envía datos) -->
					<div data-enviado hidden tabindex="-1" role="status" class="px-5 py-7 sm:px-6">
						<h2 class="text-[1.875rem] font-bold" data-enviado-titulo>Listo, recibimos tu pedido.</h2>
						<p class="mt-3 max-w-[48ch] text-[1.125rem] text-ink-2" data-enviado-texto>Un asesor te llama en el horario de atención.</p>
						<div class="mt-6 flex flex-col gap-3 sm:flex-row">
							<a data-enviado-wa href={whatsappLink()} class="ix-accion ix-seal inline-flex items-center justify-center gap-2.5 px-5 py-3.5 font-semibold no-underline">
								<Icon name="whatsapp" class="size-5" />Seguir por WhatsApp
							</a>
							<a href="/" class="ix-accion ix-wash inline-flex items-center justify-center border-2 border-ink px-5 py-3 font-semibold no-underline">Volver al inicio</a>
						</div>
						<p class="mt-6 border-t border-rule-soft pt-4 font-mono text-[0.875rem] text-ink-2">Versión demo: este formulario todavía no envía datos.</p>
					</div>
				</div>
			</section>

			<!-- Carátula del pedido -->
			<aside class="lg:pt-[13.5rem]" aria-labelledby="caratula-titulo">
				<div class="relative border-2 border-ink bg-sheet lg:sticky lg:top-24" data-caratula>
					<div class="flex flex-col gap-1 border-b-2 border-ink px-5 py-3.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
						<h2 id="caratula-titulo" class="text-[1.5rem] font-bold [font-stretch:88%]" data-caratula-titulo>Carátula del pedido</h2>
						<span class="field-no text-ink-2">{hoy}</span>
					</div>
					<div class="h-6 border-b border-rule opacity-70" style={`background:url(${tira}) left center/auto 100% repeat-x`} aria-hidden="true"></div>
					<dl class="px-5 pt-1 pb-12 sm:pb-6">
						{filasCaratula.map((f) => (
							<div class="grid grid-cols-[6.5rem_minmax(0,1fr)] items-baseline gap-x-3 border-b border-rule-soft py-3">
								<dt class="field-no text-ink-2" data-caratula-label={f.key}>{f.label}</dt>
								<dd class="min-h-[1.6em] text-[1.125rem] font-semibold [overflow-wrap:anywhere] data-[vacio]:border-b-[1.5px] data-[vacio]:border-dashed data-[vacio]:border-rule" data-caratula-valor={f.key} data-vacio></dd>
							</div>
						))}
					</dl>
					<p class="sr-only" aria-live="polite" data-anuncio></p>
					<div class="caratula-sello pointer-events-none absolute right-3 -bottom-14 size-28 sm:-right-7 sm:-bottom-10 sm:size-40" data-sello>
						<Stamp id="sello-pedido" lineas={['LISTO PARA', 'ENVIAR']} class="size-full" />
					</div>
				</div>
				<button type="submit" form="pedido-form" data-enviar-movil class="ix-accion ix-ink mt-20 flex w-full items-center justify-between gap-4 px-5 py-4 text-left text-[1.25rem] font-semibold lg:hidden">
					<span data-enviar-label>Pedir cotización</span>
					<Icon name="arrowRight" class="ix-flecha size-6 shrink-0" strokeWidth={2} />
				</button>
				<p class="mt-6 text-[1rem] text-ink-2 lg:mt-12" data-nota>
					El sello se completa cuando están los datos. ¿Preferís hablar?{' '}
					<a href={whatsappLink('Hola, quiero cotizar un seguro.')} class="ix-sub font-semibold text-seal">WhatsApp {contacto.whatsapp}</a>
				</p>
			</aside>
		</div>
	</main>
	<Footer />
	<MobileBar soloWhatsapp />
</Layout>

<style>
	[data-sello] {
		opacity: 0.22;
		transition: opacity 0.3s ease-out;
	}
	[data-sello][data-listo] {
		opacity: 1;
		animation: sello 0.8s var(--ease-out-expo) both;
	}
	/* Grupos de opciones con error: bordes en rojo y foco visible al saltar al primero */
	[data-grupo][aria-invalid='true'] label {
		border-color: var(--color-claim);
	}
	[data-grupo][aria-invalid='true'] label:has(input:focus) {
		outline: 3px solid var(--color-teal);
		outline-offset: 2px;
	}
	@keyframes sello {
		from {
			opacity: 0.2;
			transform: scale(1.4) rotate(6deg);
		}
		to {
			opacity: 1;
			transform: scale(1) rotate(0deg);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		[data-sello][data-listo] { animation: none; }
	}
</style>

<script>
	import { whatsappLink } from '../data/brokers';

	const form = document.querySelector<HTMLFormElement>('[data-pedido]')!;
	const enviado = document.querySelector<HTMLElement>('[data-enviado]')!;
	const caratula = document.querySelector<HTMLElement>('[data-caratula]')!;
	const sello = caratula.querySelector<HTMLElement>('[data-sello]')!;
	const enviarLabels = document.querySelectorAll<HTMLElement>('[data-enviar-label]');
	const anuncio = caratula.querySelector<HTMLElement>('[data-anuncio]')!;
	let listo = false;
	const el = <T extends Element = HTMLInputElement>(name: string) => form.elements.namedItem(name) as unknown as T;
	const val = (name: string) => {
		const f = form.elements.namedItem(name);
		if (f instanceof RadioNodeList) return f.value;
		return (f as HTMLInputElement | null)?.value.trim() ?? '';
	};

	const requeridos: Record<string, string[]> = {
		auto: ['marca', 'modelo', 'anio'],
		hogar: ['tipo', 'cp'],
		accidentes: ['para'],
		otro: ['seguro'],
	};
	const etiquetaBien: Record<string, string> = { auto: 'Vehículo', hogar: 'Inmueble', accidentes: 'Para', otro: 'Seguro' };
	const telValido = (v: string) => v.replace(/\D/g, '').length >= 10;
	const cpValido = (v: string) => /^\d{4}$|^[A-Za-z]\d{4}[A-Za-z]{3}$/.test(v);

	function rama() {
		return form.querySelector<HTMLInputElement>('input[name="rama"]:checked');
	}

	function bien(r: string) {
		if (r === 'auto') return [val('marca'), val('modelo'), val('anio')].filter(Boolean).join(' ');
		if (r === 'hogar') return [val('tipo'), val('cp') && `CP ${val('cp')}`].filter(Boolean).join(' · ');
		if (r === 'accidentes') return val('para');
		if (r === 'otro') return val('seguro');
		return '';
	}

	function setFila(key: string, texto: string) {
		const dd = caratula.querySelector<HTMLElement>(`[data-caratula-valor="${key}"]`)!;
		dd.textContent = texto;
		dd.toggleAttribute('data-vacio', !texto);
	}

	function completo(r: string | undefined) {
		if (!r) return false;
		const datos = requeridos[r].every((k) => (k === 'cp' ? cpValido(val(k)) : !!val(k)));
		return datos && !!val('nombre') && telValido(val('telefono'));
	}

	function actualizar() {
		const r = rama();
		const id = r?.value;
		form.querySelector('[data-rama-vacia]')!.toggleAttribute('hidden', !!id);
		form.querySelectorAll<HTMLFieldSetElement>('[data-rama-campos]').forEach((fs) => {
			const activo = fs.dataset.ramaCampos === id;
			fs.hidden = !activo;
			fs.disabled = !activo;
		});
		enviarLabels.forEach((l) => (l.textContent = r ? `Pedir cotización · ${r.dataset.label}` : 'Pedir cotización'));
		caratula.querySelector('[data-caratula-label="item"]')!.textContent = id ? etiquetaBien[id] : 'Bien';
		setFila('rama', r?.dataset.label ?? '');
		setFila('item', id ? bien(id) : '');
		setFila('nombre', val('nombre'));
		setFila('telefono', val('telefono'));
		setFila('productor', val('productor') || 'Brokers Asociados');
		const ahora = completo(id);
		sello.toggleAttribute('data-listo', ahora);
		if (ahora && !listo) anuncio.textContent = 'Listo para enviar.';
		if (!ahora && listo) anuncio.textContent = '';
		listo = ahora;
	}

	function mostrarError(key: string, on: boolean) {
		form.querySelector(`[data-error="${key}"]`)?.classList.toggle('hidden', !on);
		form.querySelector(`[data-grupo="${key}"]`)?.setAttribute('aria-invalid', String(on));
		const f = form.elements.namedItem(key);
		if (f instanceof HTMLInputElement || f instanceof HTMLSelectElement) f.setAttribute('aria-invalid', String(on));
	}

	// Contacto precargado desde la home
	let guardado: { nombre?: string; telefono?: string; productor?: string } = {};
	try {
		guardado = JSON.parse(sessionStorage.getItem('ba-contacto') ?? '{}');
	} catch {}
	const conocido = form.querySelector<HTMLElement>('[data-contacto-conocido]')!;
	const campos = form.querySelector<HTMLElement>('[data-contacto-campos]')!;
	if (guardado.nombre && guardado.telefono) {
		el('nombre').value = guardado.nombre;
		el('telefono').value = guardado.telefono;
		if (guardado.productor) el<HTMLSelectElement>('productor').value = guardado.productor;
		conocido.querySelector('[data-conocido-nombre]')!.textContent = guardado.nombre;
		conocido.querySelector('[data-conocido-tel]')!.textContent = guardado.telefono;
		conocido.hidden = false;
		campos.hidden = true;
	}
	conocido.querySelector('[data-contacto-editar]')!.addEventListener('click', () => {
		conocido.hidden = true;
		campos.hidden = false;
		el('nombre').focus();
	});

	// Rama y producto desde la URL
	const params = new URLSearchParams(location.search);
	const ramaInicial = form.querySelector<HTMLInputElement>(`input[name="rama"][value="${params.get('rama')}"]`);
	if (ramaInicial) ramaInicial.checked = true;
	const producto = params.get('producto');
	if (producto && params.get('rama') === 'otro') el<HTMLSelectElement>('seguro').value = producto;
	if (producto === 'Integral de comercio') {
		const comercio = form.querySelector<HTMLInputElement>('input[name="tipo"][value="Comercio"]');
		if (comercio) comercio.checked = true;
	}
	actualizar();

	form.addEventListener('input', (e) => {
		const t = e.target as HTMLInputElement;
		if (t.getAttribute('aria-invalid') === 'true') mostrarError(t.name, false);
		actualizar();
	});
	form.addEventListener('change', (e) => {
		const t = e.target as HTMLInputElement;
		mostrarError(t.name, false);
		actualizar();
	});

	form.addEventListener('submit', (e) => {
		e.preventDefault();
		const r = rama()?.value;
		const errores: Record<string, boolean> = { rama: !r };
		if (r) requeridos[r].forEach((k) => (errores[k] = k === 'cp' ? !cpValido(val(k)) : !val(k)));
		errores.nombre = !val('nombre');
		errores.telefono = !telValido(val('telefono'));
		if ((errores.nombre || errores.telefono) && campos.hidden) {
			conocido.hidden = true;
			campos.hidden = false;
		}
		Object.entries(errores).forEach(([k, v]) => mostrarError(k, v));
		const primero = Object.entries(errores).find(([, v]) => v)?.[0];
		if (primero) {
			const target = form.querySelector<HTMLElement>(`[name="${primero}"]:not([disabled])`);
			target?.focus();
			return;
		}

		const etiqueta = rama()!.dataset.label!;
		const nombre = val('nombre');
		enviado.querySelector('[data-enviado-titulo]')!.textContent = `Listo, ${nombre.split(' ')[0]}. Recibimos tu pedido.`;
		enviado.querySelector('[data-enviado-texto]')!.textContent =
			`Un asesor te llama al ${val('telefono')} con la propuesta para tu seguro de ${etiqueta.toLowerCase()}, de lunes a viernes de 9 a 15 hs.`;
		enviado.querySelector<HTMLAnchorElement>('[data-enviado-wa]')!.href = whatsappLink(
			`Hola, soy ${nombre}. Pedí una cotización de ${etiqueta.toLowerCase()}: ${bien(r!)}.`,
		);
		caratula.querySelector('[data-caratula-titulo]')!.textContent = 'Pedido recibido';
		sello.querySelector('[data-stamp-text]')!.innerHTML = '<tspan x="100" y="107">RECIBIDO</tspan>';
		sello.removeAttribute('data-listo');
		requestAnimationFrame(() => requestAnimationFrame(() => sello.setAttribute('data-listo', '')));
		anuncio.textContent = '';
		document.querySelector<HTMLElement>('[data-enviar-movil]')!.hidden = true;
		try {
			sessionStorage.setItem('ba-contacto', JSON.stringify({ nombre, telefono: val('telefono'), productor: val('productor') }));
		} catch {}
		form.hidden = true;
		document.querySelector<HTMLElement>('[data-nota]')!.hidden = true;
		enviado.hidden = false;
		enviado.focus();
	});
</script>
