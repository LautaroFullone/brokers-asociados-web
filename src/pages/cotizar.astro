---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Icon from '../components/Icon.astro';
import Stamp from '../components/Stamp.astro';
import {
	ramas,
	productores,
	marcasVehiculo,
	tiposInmueble,
	destinatariosAP,
	otrosSeguros,
	contacto,
	whatsappLink,
} from '../data/brokers';

const inputBase =
	'campo block w-full border-[1.5px] border-rule bg-sheet px-3.5 py-2.5 text-[1.125rem] text-ink placeholder:text-[#5f7385] transition-colors duration-200 hover:border-ink focus:border-ink focus:outline-none focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-teal aria-[invalid=true]:border-claim';
const tile =
	'opcion group relative flex min-h-12 cursor-pointer items-center gap-3 border-[1.5px] border-rule-soft bg-sheet px-3 py-2 transition-colors duration-200 hover:border-ink has-checked:border-ink has-checked:bg-wash has-focus-visible:outline-3 has-focus-visible:outline-offset-2 has-focus-visible:outline-teal';
// Opción única: indicador redondo con punto (un radio nativo del mundo), no una casilla cuadrada de selección múltiple
const radio =
	'grid size-[1.375rem] shrink-0 place-items-center rounded-full border-2 border-ink bg-sheet';
const punto =
	'size-2.5 scale-0 rounded-full bg-ink transition-transform duration-200 ease-out-expo group-has-checked:scale-100';
const row = 'paso grid grid-cols-[2.75rem_minmax(0,1fr)] border-b border-rule sm:grid-cols-[3.25rem_minmax(0,1fr)]';
const no = 'no field-no border-r border-rule pt-3.5 text-center text-ink-2';
const legend = 'leyenda float-left mb-2 w-full text-[1.125rem] font-semibold';
const err = 'mt-1.5 hidden text-[1rem] font-medium text-claim';
const label = 'rotulo mb-1 block text-[1rem] text-ink-2';

const anioActual = new Date().getFullYear();
const anios = Array.from({ length: anioActual + 1 - 1995 + 1 }, (_, i) => anioActual + 1 - i);
const hoy = new Intl.DateTimeFormat('es-AR', { dateStyle: 'long', timeZone: 'America/Argentina/Buenos_Aires' }).format(new Date());

const filasCaratula = [
	{ key: 'rama', label: 'Rama' },
	{ key: 'item', label: 'Bien' },
	{ key: 'nombre', label: 'Asegurado' },
	{ key: 'telefono', label: 'Contacto' },
	{ key: 'productor', label: 'Productor' },
];
// Estados del sello: sin empezar (rojo), incompleto (naranja), listo (verde)
const estadoInicial = ['SIN', 'EMPEZAR'];
---

<Layout
	title="Pedí tu cotización · Brokers Asociados"
	description="Cotizá tu seguro de auto, hogar, comercio, accidentes personales y más con productores asesores de Mar del Plata. Completás pocos datos y un asesor se comunica con vos."
>
	<Header />
	<main id="contenido" class="relative overflow-hidden pt-[4.5rem]">
		<div class="cot mx-auto grid max-w-[84rem] grid-cols-1 gap-x-14 gap-y-10 px-4 pt-8 pb-16 sm:px-8 lg:grid-cols-[minmax(0,1fr)_29.5rem] lg:px-12 lg:pt-10 lg:pb-24" data-cot>
			<header class="cot-intro">
				<a href="/" class="ix-sub tap inline-flex items-center gap-2 text-[1rem] font-medium">
					<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
					Volver al inicio
				</a>
				<h1 id="pedido-titulo" class="mt-5 text-[clamp(2.5rem,1.8rem+2.8vw,4rem)] font-bold [font-stretch:84%]">Pedí tu cotización</h1>
				<p class="mt-3 max-w-[44ch] text-[1.25rem] text-ink-2">Completá estos datos y un asesor se comunica con vos con la propuesta.</p>
			</header>

			<section class="cot-form" aria-labelledby="pedido-titulo">
				<div id="pedido" class="border-2 border-ink bg-sheet">
					<form id="pedido-form" data-pedido novalidate>
						<div class="cot-pasos">
						<!-- 01 · Rama (opción única) -->
						<div class={row}>
							<span class={no} aria-hidden="true"></span>
							<fieldset class="px-4 pt-3 pb-3.5 sm:px-5" data-grupo="rama" aria-describedby="err-rama">
								<legend class={legend}>¿Qué querés asegurar? <span class="font-normal text-ink-2">Elegí una</span></legend>
								<div class="clear-both grid grid-cols-1 gap-2 sm:grid-cols-2" role="radiogroup" aria-label="Qué querés asegurar">
									{ramas.map((r) => (
										<label class={tile}>
											<input type="radio" name="rama" value={r.id} data-label={r.label} class="peer sr-only" />
											<span class={radio} aria-hidden="true"><span class={punto}></span></span>
											<span class="text-[1.125rem] font-medium leading-tight">{r.label}</span>
										</label>
									))}
								</div>
								<p id="err-rama" class={err} data-error="rama">Elegí qué querés asegurar.</p>
							</fieldset>
						</div>

						<!-- 02 · Datos del bien: no existe hasta que se elige la rama -->
						<div class="paso-bien" data-bien-wrap>
							<div class="paso-bien-in">
								<div class={row}>
									<span class={no} aria-hidden="true"></span>
									<div class="px-4 pt-3 pb-4 sm:px-5">
										<fieldset data-rama-campos="auto" hidden>
											<legend class={legend}>Tu vehículo</legend>
											<div class="clear-both grid grid-cols-1 gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_8.5rem]">
												<div>
													<label for="c-marca" class={label}>Marca</label>
													<input id="c-marca" name="marca" list="c-marcas" aria-describedby="err-marca" autocomplete="off" class={inputBase} placeholder="Ej.: Volkswagen" required />
													<datalist id="c-marcas">{marcasVehiculo.map((m) => <option value={m} />)}</datalist>
													<p id="err-marca" class={err} data-error="marca">Escribí la marca.</p>
												</div>
												<div>
													<label for="c-modelo" class={label}>Modelo</label>
													<input id="c-modelo" name="modelo" aria-describedby="err-modelo" autocomplete="off" class={inputBase} placeholder="Ej.: Gol Trend" required />
													<p id="err-modelo" class={err} data-error="modelo">Escribí el modelo.</p>
												</div>
												<div>
													<label for="c-anio" class={label}>Año</label>
													<div class="relative">
														<select id="c-anio" name="anio" aria-describedby="err-anio" class={`${inputBase} appearance-none pr-9`} required>
															<option value="">Año</option>
															{anios.map((a) => <option value={a}>{a}</option>)}
															<option value="Anterior a 1995">Antes de 1995</option>
														</select>
														<svg class="pointer-events-none absolute top-1/2 right-3 size-5 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
													</div>
													<p id="err-anio" class={err} data-error="anio">Elegí el año.</p>
												</div>
											</div>
										</fieldset>

										<fieldset data-rama-campos="hogar" hidden>
											<legend class={legend}>Tu vivienda o comercio</legend>
											<div class="clear-both grid grid-cols-2 gap-2" role="radiogroup" aria-label="Tipo de inmueble" data-grupo="tipo" aria-describedby="err-tipo">
												{tiposInmueble.map((t) => (
													<label class={tile}>
														<input type="radio" name="tipo" value={t} class="peer sr-only" required />
														<span class={radio} aria-hidden="true"><span class={punto}></span></span>
														<span class="text-[1.125rem] font-medium">{t}</span>
													</label>
												))}
											</div>
											<p id="err-tipo" class={err} data-error="tipo">Elegí el tipo.</p>
											<div class="mt-3 max-w-[14rem]">
												<label for="c-cp" class={label}>Código postal</label>
												<input id="c-cp" name="cp" aria-describedby="err-cp" inputmode="numeric" autocomplete="postal-code" maxlength="8" class={inputBase} placeholder="Ej.: 7600" required />
												<p id="err-cp" class={err} data-error="cp">Escribí el código postal.</p>
											</div>
										</fieldset>

										<fieldset data-rama-campos="accidentes" hidden>
											<legend class={legend}>¿Para quién es el seguro?</legend>
											<div class="clear-both grid grid-cols-1 gap-2 sm:grid-cols-3" role="radiogroup" aria-label="Para quién es el seguro" data-grupo="para" aria-describedby="err-para">
												{destinatariosAP.map((d) => (
													<label class={tile}>
														<input type="radio" name="para" value={d} class="peer sr-only" required />
														<span class={radio} aria-hidden="true"><span class={punto}></span></span>
														<span class="text-[1.125rem] font-medium">{d}</span>
													</label>
												))}
											</div>
											<p id="err-para" class={err} data-error="para">Elegí para quién es.</p>
										</fieldset>

										<fieldset data-rama-campos="otro" hidden>
											<legend class={legend}>¿Qué seguro necesitás?</legend>
											<div class="clear-both relative max-w-[26rem]">
												<label for="c-seguro" class="sr-only">Seguro</label>
												<select id="c-seguro" name="seguro" aria-describedby="err-seguro" class={`${inputBase} appearance-none pr-10`} required>
													<option value="">Elegí una opción</option>
													{otrosSeguros.map((s) => <option value={s}>{s}</option>)}
												</select>
												<svg class="pointer-events-none absolute top-1/2 right-3.5 size-5 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
											</div>
											<p id="err-seguro" class={err} data-error="seguro">Elegí qué seguro necesitás.</p>
											<div class="mt-3">
												<label for="c-comentario" class={label}>¿Algo que debamos saber? <span class="text-ink-2">Opcional</span></label>
												<textarea id="c-comentario" name="comentario" rows="2" class={`${inputBase} resize-y`}></textarea>
											</div>
										</fieldset>
									</div>
								</div>
							</div>
						</div>

						<!-- 03 · Contacto -->
						<div class={row}>
							<span class={no} aria-hidden="true"></span>
							<fieldset class="px-4 pt-3 pb-4 sm:px-5">
								<legend class={legend}>Tus datos</legend>
								<div class="clear-both flex items-center justify-between gap-4 bg-wash px-3.5 py-3 text-[1.125rem]" data-contacto-conocido hidden>
									<span><strong class="font-semibold" data-conocido-nombre></strong> · <span data-conocido-tel></span></span>
									<button type="button" class="ix-sub tap font-medium" data-contacto-editar>Cambiar</button>
								</div>
								<div class="clear-both grid grid-cols-1 gap-3 sm:grid-cols-2" data-contacto-campos>
									<div>
										<label for="c-nombre" class={label}>Nombre</label>
										<input id="c-nombre" name="nombre" aria-describedby="err-nombre" autocomplete="name" class={inputBase} required />
										<p id="err-nombre" class={err} data-error="nombre">Escribí tu nombre.</p>
									</div>
									<div>
										<label for="c-tel" class={label}>Teléfono o celular</label>
										<input id="c-tel" name="telefono" aria-describedby="err-telefono" type="tel" inputmode="tel" autocomplete="tel" placeholder="Ej.: 223 555-1234" class={inputBase} required />
										<p id="err-telefono" class={err} data-error="telefono">Revisá el número: con característica, por ejemplo 223 555-1234.</p>
									</div>
								</div>
								<div class="mt-4" role="radiogroup" aria-labelledby="via-titulo">
									<p id="via-titulo" class="mb-2 text-[1rem] text-ink-2">¿Cómo preferís que te contactemos? <span>Opcional</span></p>
									<div class="grid grid-cols-2 gap-2 sm:max-w-[22rem]">
										{['Llamada', 'WhatsApp'].map((v) => (
											<label class={`${tile} !gap-2 !px-2.5`} data-via>
												<input type="radio" name="via" value={v} class="peer sr-only" />
												<span class={radio} aria-hidden="true"><span class={punto}></span></span>
												<span class="text-[1.125rem] font-medium">{v}</span>
											</label>
										))}
									</div>
								</div>
							</fieldset>
						</div>

						<!-- 04 · Productor -->
						<div class={row}>
							<span class={no} aria-hidden="true"></span>
							<div class="px-4 pt-3 pb-4 sm:px-5">
								<label for="c-productor" class="mb-2 flex flex-wrap items-baseline gap-x-3 text-[1.125rem] font-semibold">
									¿Ya trabajás con alguno de nuestros productores? <span class="font-normal text-ink-2">Opcional</span>
								</label>
								<div class="relative">
									<select id="c-productor" name="productor" class={`${inputBase} appearance-none pr-10`}>
										<option value="">No, todavía no</option>
										<optgroup label="Sí, mi productor es:">{productores.map((p) => <option value={p}>{p}</option>)}</optgroup>
									</select>
									<svg class="pointer-events-none absolute top-1/2 right-3.5 size-5 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
								</div>
							</div>
						</div>
					</div>
					</form>

				<!-- Enviado (demo: no envía datos) -->
				<div data-enviado hidden tabindex="-1" role="status" class="px-5 py-7 sm:px-6">
					<h2 class="text-[1.875rem] font-bold" data-enviado-titulo>Listo, recibimos tu solicitud.</h2>
					<p class="mt-3 max-w-[48ch] text-[1.125rem] text-ink-2" data-enviado-texto>Un asesor se comunicará con vos al número que ingresaste con la propuesta a la brevedad.</p>
					<div class="mt-6 flex flex-col gap-3 sm:flex-row">
						<a data-enviado-wa href={whatsappLink()} class="ix-accion ix-seal inline-flex items-center justify-center gap-2.5 px-5 py-3.5 font-semibold no-underline">
							<Icon name="whatsapp" class="size-5" />Seguir por WhatsApp
						</a>
						<a href="/" class="ix-accion ix-wash inline-flex items-center justify-center border-2 border-ink px-5 py-3 font-semibold no-underline">Volver al inicio</a>
					</div>
				</div>
				</div>
			</section>

			<!-- Recibo de la solicitud, con el sello en tres estados y el botón de enviar debajo -->
			<aside class="cot-aside lg:self-start" aria-labelledby="caratula-titulo">
				<div class="lg:sticky lg:top-24">
					<div class="car relative" data-caratula data-estado="vacio">
						<div class="car-head">
							<h2 id="caratula-titulo" class="car-titulo" data-caratula-titulo>Tu solicitud</h2>
							<span class="field-no car-fecha">{hoy}</span>
						</div>
						<div class="car-corte" aria-hidden="true"></div>
						<dl class="car-lista">
							{filasCaratula.map((f) => (
								<div class="car-fila" data-fila-car={f.key}>
									<dt class="car-dt field-no" data-caratula-label={f.key}>{f.label}</dt>
									<dd class="car-dd" data-caratula-valor={f.key} data-vacio></dd>
								</div>
							))}
						</dl>
						<div class="car-estado">
							<div>
								<ul class="car-meter" aria-hidden="true" data-meter>
									<li></li><li></li><li></li><li></li>
								</ul>
								<p class="car-falta" id="falta-texto" data-falta>Empezá eligiendo qué querés asegurar.</p>
							</div>
							<div class="car-sello pointer-events-none" data-sello data-estado="vacio">
								<Stamp id="sello-pedido" lineas={estadoInicial} class="size-full" />
							</div>
						</div>
						<p class="sr-only" role="status" aria-live="polite" data-anuncio></p>
					</div>

					<button type="submit" form="pedido-form" class="enviar ix-accion ix-ink mt-5 flex w-full items-center justify-between gap-4 px-5 py-4 text-left text-[1.25rem] font-semibold sm:px-6 sm:text-[1.375rem]" data-enviar disabled aria-describedby="falta-texto">
						<span>Pedir cotización</span>
						<Icon name="arrowRight" class="ix-flecha size-6 shrink-0" strokeWidth={2} />
					</button>
					<p class="mt-6 text-[1rem] text-ink-2" data-nota>
						¿Preferís hablar?{' '}
						<a href={whatsappLink('Hola, quiero cotizar un seguro.')} class="ix-sub font-semibold text-seal">WhatsApp {contacto.whatsapp}</a>
					</p>
				</div>
			</aside>
		</div>
	</main>
	<Footer />
	<MobileBar soloWhatsapp />
</Layout>

<style>
	/* ——— Numeración: cuenta solo las filas que existen ——— */
	.cot-pasos { counter-reset: paso; }
	.paso { counter-increment: paso; }
	.paso-bien:not([data-abierto]) .paso { counter-increment: none; }
	.paso .no::before { content: counter(paso, decimal-leading-zero); }

	/* El paso de datos no existe hasta que se elige la rama, y entonces se abre */
	.paso-bien {
		display: grid;
		grid-template-rows: 0fr;
		opacity: 0;
		transition: grid-template-rows 0.45s var(--ease-out-expo), opacity 0.3s var(--ease-out-expo);
	}
	.paso-bien[data-abierto] { grid-template-rows: 1fr; opacity: 1; }
	.paso-bien-in { overflow: hidden; min-height: 0; }

	/* Grupos de opciones con error: bordes en rojo y foco visible al saltar al primero */
	[data-grupo][aria-invalid='true'] label { border-color: var(--color-claim); }
	[data-grupo][aria-invalid='true'] label:has(input:focus) { outline: 3px solid var(--color-teal); outline-offset: 2px; }

	/* ——— Composición: el recibo arranca a la altura del formulario, no del titular ——— */
	@media (min-width: 1024px) {
		.cot-intro { grid-column: 1; grid-row: 1; }
		.cot-form { grid-column: 1; grid-row: 2; }
		.cot-aside { grid-column: 2; grid-row: 2; }
	}

	/* ——— Carátula: estructura común ——— */
	.car {
		--estado: var(--color-ink-2);
		position: relative;
		border: 2px solid var(--color-ink);
		background: var(--color-sheet);
	}
	/* Sin empezar en gris de tinta: el bordó queda para siniestros y para errores reales */
	.car[data-estado='vacio'] .car-sello { opacity: 0.55; }
	.car[data-estado='incompleto'] { --estado: var(--color-warn); }
	.car[data-estado='listo'] { --estado: var(--color-seal); }
	.car-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.25rem 1rem; padding: 1.125rem 1.25rem 1rem; }
	.car-titulo { font-size: 1.5rem; font-weight: 700; font-stretch: 88%; }
	/* Línea de corte de ticket: renglón punteado con una muesca a cada lado */
	.car-corte { position: relative; border-top: 1.5px dashed var(--color-rule); }
	.car-corte::before,
	.car-corte::after {
		content: '';
		position: absolute;
		top: -10px;
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background: var(--color-paper);
		border: 2px solid var(--color-ink);
	}
	/* El recorte pasa 1px del centro hacia afuera: con la tarjeta en medio píxel, el borde antialiaseado asomaba dentro de la muesca */
	.car-corte::before { left: -11px; clip-path: inset(0 0 0 calc(50% - 1px)); }
	.car-corte::after { right: -11px; clip-path: inset(0 calc(50% - 1px) 0 0); }
	.car-fecha { color: var(--color-ink-2); }
	.car-lista { padding: 0.25rem 1.25rem 0; }
	.car-fila { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); align-items: baseline; gap: 0 0.75rem; padding: 0.75rem 0; border-bottom: 1px solid var(--color-rule-soft); }
	.car-dt { color: var(--color-ink-2); }
	.car-dd { min-height: 1.6em; font-size: 1.125rem; font-weight: 600; overflow-wrap: anywhere; }
	.car-dd[data-vacio] { border-bottom: 1.5px dashed var(--color-rule); }
	.car-estado { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 0.5rem 1rem; padding: 1rem 1.25rem 1.25rem; }
	.car-meter { display: flex; gap: 0.375rem; list-style: none; margin: 0; padding: 0; }
	.car-meter li { height: 6px; flex: 1; background: var(--color-rule-soft); transition: background-color 0.3s var(--ease-out-expo); }
	.car-meter li[data-on] { background: var(--estado); }
	.car-falta { margin-top: 0.625rem; font-size: 1rem; font-weight: 600; color: var(--estado); text-wrap: pretty; }
	.car-sello { grid-column: 2; grid-row: 1 / span 2; width: 7.5rem; height: 7.5rem; color: var(--estado); transform: rotate(var(--giro, -6deg)); transition: color 0.3s ease-out; }
	.car-sello :global(.stamp) { color: inherit; transform: none; }
	.car-sello.golpe { animation: sello-golpe 0.7s var(--ease-out-expo) both; }
	@keyframes sello-golpe {
		from { opacity: 0.2; transform: scale(1.45) rotate(8deg); }
		to { opacity: 1; transform: scale(1) rotate(var(--giro, -6deg)); }
	}

	/* ——— Botón de enviar: se habilita con el sello verde ——— */
	.enviar { border: 1.5px solid transparent; }
	.enviar[disabled] {
		background-color: transparent;
		color: var(--color-ink-2);
		border-color: var(--color-rule);
		border-style: dashed;
		cursor: not-allowed;
		transform: none;
	}
	.enviar[disabled] .ix-flecha { opacity: 0.4; transform: none; }
	.enviar.listo .ix-flecha { animation: aviso-flecha 0.9s var(--ease-out-expo) 1; }
	@keyframes aviso-flecha {
		0%, 100% { transform: translateX(0); }
		30% { transform: translateX(8px); }
		60% { transform: translateX(2px); }
	}

	/* ═══ Recibo: comprobante de caja (los campos usan la caja común del sitio) ═══ */
	.car-fila { border-bottom: 1px dashed var(--color-rule); }
	.car-dd { font-family: var(--font-mono); font-size: 1.0625rem; font-weight: 500; }
	.car { border-bottom: 0; padding-bottom: 12px; }
	.car::after {
		content: '';
		position: absolute;
		inset: auto -2px -1px;
		height: 12px;
		background: radial-gradient(circle at 50% 100%, var(--color-paper) 0 5px, transparent 5.5px) 0 0 / 16px 12px repeat-x;
		border-bottom: 2px solid transparent;
	}
	.car-estado { border-top: 1px dashed var(--color-rule); margin-top: 0.5rem; }
	.paso { border-bottom-style: dashed; }
	.opcion { border-color: var(--color-rule); }

	@media (prefers-reduced-motion: reduce) {
		.paso-bien, .car-meter li, .car-sello { transition: none; }
		.car-sello.golpe, .enviar.listo .ix-flecha { animation: none; }
	}
</style>

<script>
	import { whatsappLink } from '../data/brokers';

	const form = document.querySelector<HTMLFormElement>('[data-pedido]')!;
	const enviado = document.querySelector<HTMLElement>('[data-enviado]')!;
	const caratula = document.querySelector<HTMLElement>('[data-caratula]')!;
	const sello = caratula.querySelector<HTMLElement>('[data-sello]')!;
	const enviar = document.querySelector<HTMLButtonElement>('[data-enviar]')!;
	const anuncio = caratula.querySelector<HTMLElement>('[data-anuncio]')!;
	const falta = caratula.querySelector<HTMLElement>('[data-falta]')!;
	const meter = [...caratula.querySelectorAll<HTMLElement>('[data-meter] li')];
	const bienWrap = form.querySelector<HTMLElement>('[data-bien-wrap]')!;
	const sinMovimiento = matchMedia('(prefers-reduced-motion: reduce)');

	const el = <T extends Element = HTMLInputElement>(name: string) => form.elements.namedItem(name) as unknown as T;
	const val = (name: string) => {
		const f = form.elements.namedItem(name);
		if (f instanceof RadioNodeList) return f.value;
		return (f as HTMLInputElement | null)?.value.trim() ?? '';
	};

	const requeridos: Record<string, string[]> = {
		auto: ['marca', 'modelo', 'anio'],
		hogar: ['tipo', 'cp'],
		accidentes: ['para'],
		otro: ['seguro'],
	};
	const etiquetaBien: Record<string, string> = { auto: 'Vehículo', hogar: 'Inmueble', accidentes: 'Para', otro: 'Seguro' };
	const faltaBien: Record<string, string> = {
		auto: 'los datos del vehículo',
		hogar: 'los datos del inmueble',
		accidentes: 'para quién es',
		otro: 'qué seguro necesitás',
	};
	const telValido = (v: string) => v.replace(/\D/g, '').length >= 10;
	const cpValido = (v: string) => /^\d{4}$|^[A-Za-z]\d{4}[A-Za-z]{3}$/.test(v);
	const campoOk = (k: string) => (k === 'cp' ? cpValido(val(k)) : k === 'telefono' ? telValido(val(k)) : !!val(k));

	// Sello en tres estados: gris sin empezar, naranja incompleto, verde listo
	const sellos: Record<string, string[]> = {
		vacio: ['SIN', 'EMPEZAR'],
		incompleto: ['SOLICITUD', 'INCOMPLETA'],
		listo: ['LISTA PARA', 'ENVIAR'],
	};
	function escribirSello(lineas: string[]) {
		const y0 = 100 - (lineas.length - 1) * 11;
		sello.querySelector('[data-stamp-text]')!.innerHTML = lineas
			.map((l, i) => `<tspan x="100" y="${y0 + i * 22 + 7}">${l}</tspan>`)
			.join('');
	}

	function rama() {
		return form.querySelector<HTMLInputElement>('input[name="rama"]:checked');
	}

	function bien(r: string) {
		if (r === 'auto') return [val('marca'), val('modelo'), val('anio')].filter(Boolean).join(' ');
		if (r === 'hogar') return [val('tipo'), val('cp') && `CP ${val('cp')}`].filter(Boolean).join(' · ');
		if (r === 'accidentes') return val('para');
		if (r === 'otro') return val('seguro');
		return '';
	}

	function setFila(key: string, texto: string) {
		const dd = caratula.querySelector<HTMLElement>(`[data-caratula-valor="${key}"]`)!;
		dd.textContent = texto;
		dd.toggleAttribute('data-vacio', !texto);
	}

	let estado = '';
	let recibido = false;

	function actualizar(inicial = false) {
		const r = rama();
		const id = r?.value;
		bienWrap.toggleAttribute('data-abierto', !!id);
		form.querySelectorAll<HTMLFieldSetElement>('[data-rama-campos]').forEach((fs) => {
			const activo = fs.dataset.ramaCampos === id;
			fs.hidden = !activo;
			fs.disabled = !activo;
		});
		caratula.querySelector('[data-caratula-label="item"]')!.textContent = id ? etiquetaBien[id] : 'Bien';
		setFila('rama', r?.dataset.label ?? '');
		setFila('item', id ? bien(id) : '');
		setFila('nombre', val('nombre'));
		setFila('telefono', [val('telefono'), val('via')].filter(Boolean).join(' · '));
		setFila('productor', val('productor') || 'Brokers Asociados');
		if (recibido) return;

		const bienOk = !!id && requeridos[id].every(campoOk);
		const items = [!!id, bienOk, !!val('nombre'), telValido(val('telefono'))];
		meter.forEach((li, i) => li.toggleAttribute('data-on', items[i]));
		const completo = items.every(Boolean);
		const empezo = !!id || !!val('nombre') || !!val('telefono') || !!val('productor') || ['marca', 'modelo', 'anio', 'tipo', 'cp', 'para', 'seguro'].some((k) => !!val(k));
		const nuevo = completo ? 'listo' : empezo ? 'incompleto' : 'vacio';

		const faltantes: string[] = [];
		if (!id) faltantes.push('qué querés asegurar');
		else if (!bienOk) faltantes.push(faltaBien[id]);
		if (!items[2]) faltantes.push('tu nombre');
		if (!items[3]) faltantes.push('un teléfono válido');
		const texto =
			nuevo === 'listo'
				? 'Solicitud completa: ya podés enviarla.'
				: nuevo === 'vacio'
					? 'Empezá eligiendo qué querés asegurar.'
					: `Falta: ${faltantes.join(', ')}.`;
		falta.textContent = texto;

		enviar.disabled = !completo;
		enviar.classList.toggle('listo', completo);

		if (nuevo !== estado) {
			caratula.dataset.estado = nuevo;
			sello.dataset.estado = nuevo;
			escribirSello(sellos[nuevo]);
			if (!inicial) {
				sello.classList.remove('golpe');
				void sello.offsetWidth;
				sello.classList.add('golpe');
				anuncio.textContent = nuevo === 'listo' ? 'Solicitud completa. Ya podés enviarla.' : nuevo === 'incompleto' ? `Solicitud incompleta. ${texto}` : '';
				if (nuevo === 'listo' && !sinMovimiento.matches) navigator.vibrate?.(15);
			}
			estado = nuevo;
		}
	}

	function mostrarError(key: string, on: boolean) {
		form.querySelector(`[data-error="${key}"]`)?.classList.toggle('hidden', !on);
		form.querySelector(`[data-grupo="${key}"]`)?.setAttribute('aria-invalid', String(on));
		const f = form.elements.namedItem(key);
		if (f instanceof HTMLInputElement || f instanceof HTMLSelectElement) f.setAttribute('aria-invalid', String(on));
	}

	// Contacto precargado desde la home
	let guardado: { nombre?: string; telefono?: string; productor?: string } = {};
	try {
		guardado = JSON.parse(sessionStorage.getItem('ba-contacto') ?? '{}');
	} catch {}
	const conocido = form.querySelector<HTMLElement>('[data-contacto-conocido]')!;
	const campos = form.querySelector<HTMLElement>('[data-contacto-campos]')!;
	if (guardado.nombre && guardado.telefono) {
		el('nombre').value = guardado.nombre;
		el('telefono').value = guardado.telefono;
		if (guardado.productor) el<HTMLSelectElement>('productor').value = guardado.productor;
		conocido.querySelector('[data-conocido-nombre]')!.textContent = guardado.nombre;
		conocido.querySelector('[data-conocido-tel]')!.textContent = guardado.telefono;
		conocido.hidden = false;
		campos.hidden = true;
	}
	conocido.querySelector('[data-contacto-editar]')!.addEventListener('click', () => {
		conocido.hidden = true;
		campos.hidden = false;
		el('nombre').focus();
	});

	// Rama y producto desde la URL
	const params = new URLSearchParams(location.search);
	const ramaInicial = form.querySelector<HTMLInputElement>(`input[name="rama"][value="${params.get('rama')}"]`);
	if (ramaInicial) ramaInicial.checked = true;
	const producto = params.get('producto');
	if (producto && params.get('rama') === 'otro') el<HTMLSelectElement>('seguro').value = producto;
	if (producto === 'Integral de comercio') {
		const comercio = form.querySelector<HTMLInputElement>('input[name="tipo"][value="Comercio"]');
		if (comercio) comercio.checked = true;
	}
	actualizar(true);

	// «Cómo preferís que te contactemos?» es opcional: volver a tocar la opción elegida la quita
	form.querySelectorAll<HTMLLabelElement>('[data-via]').forEach((label) => {
		const input = label.querySelector<HTMLInputElement>('input')!;
		let estabaMarcada = false;
		label.addEventListener('pointerdown', () => (estabaMarcada = input.checked));
		label.addEventListener('click', (e) => {
			if (!estabaMarcada) return;
			e.preventDefault();
			input.checked = false;
			estabaMarcada = false;
			actualizar();
		});
	});

	form.addEventListener('input', (e) => {
		const t = e.target as HTMLInputElement;
		if (t.getAttribute('aria-invalid') === 'true') mostrarError(t.name, false);
		actualizar();
	});
	form.addEventListener('change', (e) => {
		const t = e.target as HTMLInputElement;
		mostrarError(t.name, false);
		actualizar();
	});
	// Al salir de un campo obligatorio vacío o inválido, se avisa en el momento
	form.addEventListener('focusout', (e) => {
		const t = e.target as HTMLInputElement;
		if (!t.required || t.disabled || !t.name) return;
		mostrarError(t.name, !campoOk(t.name));
	});

	function errores() {
		const r = rama()?.value;
		const e: Record<string, boolean> = { rama: !r };
		if (r) requeridos[r].forEach((k) => (e[k] = !campoOk(k)));
		e.nombre = !val('nombre');
		e.telefono = !telValido(val('telefono'));
		if ((e.nombre || e.telefono) && campos.hidden) {
			conocido.hidden = true;
			campos.hidden = false;
		}
		Object.entries(e).forEach(([k, v]) => mostrarError(k, v));
		return Object.entries(e).find(([, v]) => v)?.[0];
	}

	// Con el botón deshabilitado Enter no envía: se marca qué falta; con todo completo, envía
	form.addEventListener('keydown', (e) => {
		const t = e.target as HTMLElement;
		if (e.key !== 'Enter' || t.tagName === 'TEXTAREA' || t.tagName === 'BUTTON' || (t as HTMLInputElement).type === 'radio') return;
		e.preventDefault();
		if (enviar.disabled) {
			const primero = errores();
			if (primero) form.querySelector<HTMLElement>(`[name="${primero}"]:not([disabled])`)?.focus();
		} else form.requestSubmit(enviar);
	});

	form.addEventListener('submit', (e) => {
		e.preventDefault();
		const primero = errores();
		if (primero) {
			form.querySelector<HTMLElement>(`[name="${primero}"]:not([disabled])`)?.focus();
			return;
		}

		const r = rama()!.value;
		const etiqueta = rama()!.dataset.label!;
		const nombre = val('nombre');
		const via = val('via');
		enviado.querySelector('[data-enviado-titulo]')!.textContent = `Listo, ${nombre.split(' ')[0]}. Recibimos tu solicitud.`;
		enviado.querySelector('[data-enviado-texto]')!.textContent =
			via === 'WhatsApp'
				? 'Un asesor se comunicará con vos por WhatsApp, al número que ingresaste, con la propuesta a la brevedad.'
				: 'Un asesor se comunicará con vos al número que ingresaste con la propuesta a la brevedad.';
		enviado.querySelector<HTMLAnchorElement>('[data-enviado-wa]')!.href = whatsappLink(
			`Hola, soy ${nombre}. Quiero cotizar mi seguro de ${etiqueta.toLowerCase()}: ${bien(r)}.`,
		);
		recibido = true;
		caratula.querySelector('[data-caratula-titulo]')!.textContent = 'Solicitud recibida';
		caratula.dataset.estado = 'listo';
		sello.dataset.estado = 'listo';
		escribirSello(['RECIBIDA']);
		falta.textContent = 'Tus datos ya están con nuestro equipo.';
		sello.classList.remove('golpe');
		void sello.offsetWidth;
		sello.classList.add('golpe');
		anuncio.textContent = '';
		enviar.hidden = true;
		document.querySelector<HTMLElement>('[data-nota]')!.hidden = true;
		try {
			sessionStorage.setItem('ba-contacto', JSON.stringify({ nombre, telefono: val('telefono'), productor: val('productor') }));
		} catch {}
		form.hidden = true;
		enviado.hidden = false;
		enviado.focus();
	});
</script>
